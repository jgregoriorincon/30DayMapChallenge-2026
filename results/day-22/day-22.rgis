xport Features: 447 features"],"millis":0,"outputs":["Deformación"]},{"tool":"Summary Statistics","id":"summaryStatistics","params":{"input":"Deformación","separator":", ","statistics":[{"field":"k","statistic":"MIN"},{"field":"k","statistic":"MAX"},{"field":"area_scale","statistic":"MAX"}]},"at":1795216353,"ok":true,"messages":["Summary Statistics: 1 rows"],"millis":0,"outputs":[]}],"layouts":[{"name":"Dia 22","width":210.0,"height":297.0,"elements":[{"id":2,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,255],"outline":[255,255,255,0],"width":0.0}}},{"id":1,"name":"Map Frame","x":12.0,"y":36.0,"w":186.0,"h":190.0,"visible":true,"kind":{"MapFrame":{"map":"Colombia","center":{"x":-74.17,"y":4.66},"scale":10500000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DÍA 22 · PROJECTIONS · COLOMBIA","size":7.5,"color":[140,28,44,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":12.0,"y":9.5,"w":186.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"El mapa oficial de Colombia no mide igual en todas partes","size":17.0,"color":[43,38,32,255],"bold":true}}},{"id":5,"name":"Text","x":12.0,"y":19.5,"w":186.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Desde 2020 todo el país se dibuja en un solo plano, el Origen Nacional (CTM12, EPSG:9377). Pero un plano no puede copiar\nuna Tierra curva: cada círculo es el mismo círculo de 20 km en el terreno, y su color dice cuántos metros de más o de menos\nmide el mapa en cada kilómetro. Encoge en el centro, mide exacto en dos franjas y estira hacia los bordes.","size":8.0,"color":[78,70,60,255],"bold":false}}},{"id":6,"name":"Text","x":31.0,"y":44.6,"w":26.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"San Andrés · +10,3","size":6.5,"color":[140,28,44,255],"bold":true}}},{"id":7,"name":"Text","x":59.5,"y":159.1,"w":20.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"Tumaco · +4,4","size":6.5,"color":[181,70,47,255],"bold":true}}},{"id":8,"name":"Text","x":109.5,"y":129.2,"w":20.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"Bogotá · −0,6","size":6.5,"color":[43,92,138,255],"bold":true}}},{"id":9,"name":"Text","x":142.0,"y":112.7,"w":30.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"Puerto Carreño · +3,8","size":6.5,"color":[181,70,47,255],"bold":true,"align":"Right"}}},{"id":10,"name":"Text","x":84.0,"y":173.4,"w":18.0,"h":3.4,"visible":true,"background":{"fill":[255,255,255,170],"outline":[34,34,34,255],"radius":1.0,"padding":0.4},"kind":{"Text":{"text":"escala exacta","size":6.0,"color":[43,38,32,255],"bold":false,"italic":true,"align":"Center","rotation":-90.0}}},{"id":11,"name":"Text","x":132.7,"y":173.4,"w":18.0,"h":3.4,"visible":true,"background":{"fill":[255,255,255,170],"outline":[34,34,34,255],"radius":1.0,"padding":0.4},"kind":{"Text":{"text":"escala exacta","size":6.0,"color":[43,38,32,255],"bold":false,"italic":true,"align":"Center","rotation":-90.0}}},{"id":12,"name":"Text","x":12.0,"y":228.5,"w":126.0,"h":3.6,"visible":true,"kind":{"Text":{"text":"Error de escala: metros de más (+) o de menos (−) por cada kilómetro","size":6.5,"color":[43,38,32,255],"bold":true}}},{"id":13,"name":"Rectangle","x":12.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[43,92,138,255],"outline":[43,92,138,0],"width":0.0}}},{"id":14,"name":"Rectangle","x":30.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[141,182,217,255],"outline":[141,182,217,0],"width":0.0}}},{"id":15,"name":"Rectangle","x":48.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[227,222,211,255],"outline":[227,222,211,0],"width":0.0}}},{"id":16,"name":"Rectangle","x":66.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[245,195,142,255],"outline":[245,195,142,0],"width":0.0}}},{"id":17,"name":"Rectangle","x":84.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[236,139,78,255],"outline":[236,139,78,0],"width":0.0}}},{"id":18,"name":"Rectangle","x":102.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[207,74,54,255],"outline":[207,74,54,0],"width":0.0}}},{"id":19,"name":"Rectangle","x":120.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[140,28,44,255],"outline":[140,28,44,0],"width":0.0}}},{"id":20,"name":"Text","x":11.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"−0,8 a −0,4","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":21,"name":"Text","x":29.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"−0,4 a 0","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":22,"name":"Text","x":47.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"0 a +0,5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":23,"name":"Text","x":65.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"+0,5 a +2,5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":24,"name":"Text","x":83.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"+2,5 a +5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":25,"name":"Text","x":101.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"+5 a +7,5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":26,"name":"Text","x":119.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"más de +7,5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":27,"name":"Text","x":144.0,"y":232.0,"w":54.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Lo tenue es el mismo cálculo\nfuera del país.","size":6.0,"color":[133,122,108,255],"bold":false,"italic":true}}},{"id":28,"name":"Text","x":12.0,"y":243.0,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"99,94 km","size":16.0,"color":[43,92,138,255],"bold":true}}},{"id":29,"name":"Text","x":12.0,"y":251.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"mide en el mapa un camino de 100 km cerca\nde Bogotá: el plano encoge 0,6 m por kilómetro\n(0,8 sobre el meridiano −73°).","size":6.8,"color":[43,38,32,255],"bold":false}}},{"id":30,"name":"Text","x":75.0,"y":243.0,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"101,03 km","size":16.0,"color":[140,28,44,255],"bold":true}}},{"id":31,"name":"Text","x":75.0,"y":251.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"mide el mismo camino en San Andrés: 10,3 m\nde más por kilómetro, y las áreas se inflan\nun 2,08 %.","size":6.8,"color":[43,38,32,255],"bold":false}}},{"id":32,"name":"Text","x":138.0,"y":243.0,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"254 km","size":16.0,"color":[43,38,32,255],"bold":true}}},{"id":33,"name":"Text","x":138.0,"y":251.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"a cada lado del meridiano −73°, el mapa mide\nexacto: dos franjas que cruzan el país de norte\na sur, entre lo que encoge y lo que estira.","size":6.8,"color":[43,38,32,255],"bold":false}}},{"id":34,"name":"Line","x":12.0,"y":265.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[205,191,174,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":35,"name":"Text","x":12.0,"y":266.5,"w":186.0,"h":12.5,"visible":true,"kind":{"Text":{"text":"Notas: círculos de Tissot de 20 km de radio cada 0,5°, con el factor de escala k que RustGIS calcula para el Origen Nacional (Transversa de Mercator,\nmeridiano −73°, k = 0,9992); el color es (k − 1) × 1 000. La proyección es conforme: el error es el mismo en todas las direcciones y el del área es\nel doble. Antes de 2020 había cinco orígenes Gauss-Krüger, franjas de 3° con no más de 0,35 m/km de error, pero cinco sistemas de coordenadas. Mapa a\n1:10 500 000. Datos: DANE, Marco Geoestadístico Nacional 2025 (departamentos); IGAC, Resolución 471 de 2020 (Origen Nacional).","size":5.6,"color":[133,122,108,255],"bold":false}}},{"id":36,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Día 22: Projections · Hecho con RustGIS · rustgis.app","size":6.5,"color":[78,70,60,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":37},{"name":"Day 22","width":210.0,"height":297.0,"elements":[{"id":2,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,255],"outline":[255,255,255,0],"width":0.0}}},{"id":1,"name":"Map Frame","x":12.0,"y":36.0,"w":186.0,"h":190.0,"visible":true,"kind":{"MapFrame":{"map":"Colombia","center":{"x":-74.17,"y":4.66},"scale":10500000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 22 · PROJECTIONS · COLOMBIA","size":7.5,"color":[140,28,44,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":12.0,"y":9.5,"w":186.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"Colombia's official map doesn't measure the same everywhere","size":17.0,"color":[43,38,32,255],"bold":true}}},{"id":5,"name":"Text","x":12.0,"y":19.5,"w":186.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Since 2020 the whole country is drawn on a single plane, the National Origin (CTM12, EPSG:9377). But a plane can't copy\na curved Earth: every circle is the same 20 km circle on the ground, and its colour tells how many metres too many or too few\nthe map measures in each kilometre. It shrinks in the middle, is exact along two bands and stretches towards the edges.","size":8.0,"color":[78,70,60,255],"bold":false}}},{"id":6,"name":"Text","x":31.0,"y":44.6,"w":26.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"San Andrés · +10.3","size":6.5,"color":[140,28,44,255],"bold":true}}},{"id":7,"name":"Text","x":59.5,"y":159.1,"w":20.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"Tumaco · +4.4","size":6.5,"color":[181,70,47,255],"bold":true}}},{"id":8,"name":"Text","x":109.5,"y":129.2,"w":20.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"Bogotá · −0.6","size":6.5,"color":[43,92,138,255],"bold":true}}},{"id":9,"name":"Text","x":142.0,"y":112.7,"w":30.0,"h":3.8,"visible":true,"background":{"fill":[255,255,255,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.5},"kind":{"Text":{"text":"Puerto Carreño · +3.8","size":6.5,"color":[181,70,47,255],"bold":true,"align":"Right"}}},{"id":10,"name":"Text","x":84.0,"y":173.4,"w":18.0,"h":3.4,"visible":true,"background":{"fill":[255,255,255,170],"outline":[34,34,34,255],"radius":1.0,"padding":0.4},"kind":{"Text":{"text":"true scale","size":6.0,"color":[43,38,32,255],"bold":false,"italic":true,"align":"Center","rotation":-90.0}}},{"id":11,"name":"Text","x":132.7,"y":173.4,"w":18.0,"h":3.4,"visible":true,"background":{"fill":[255,255,255,170],"outline":[34,34,34,255],"radius":1.0,"padding":0.4},"kind":{"Text":{"text":"true scale","size":6.0,"color":[43,38,32,255],"bold":false,"italic":true,"align":"Center","rotation":-90.0}}},{"id":12,"name":"Text","x":12.0,"y":228.5,"w":126.0,"h":3.6,"visible":true,"kind":{"Text":{"text":"Scale error: metres too many (+) or too few (−) in each kilometre","size":6.5,"color":[43,38,32,255],"bold":true}}},{"id":13,"name":"Rectangle","x":12.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[43,92,138,255],"outline":[43,92,138,0],"width":0.0}}},{"id":14,"name":"Rectangle","x":30.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[141,182,217,255],"outline":[141,182,217,0],"width":0.0}}},{"id":15,"name":"Rectangle","x":48.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[227,222,211,255],"outline":[227,222,211,0],"width":0.0}}},{"id":16,"name":"Rectangle","x":66.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[245,195,142,255],"outline":[245,195,142,0],"width":0.0}}},{"id":17,"name":"Rectangle","x":84.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[236,139,78,255],"outline":[236,139,78,0],"width":0.0}}},{"id":18,"name":"Rectangle","x":102.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[207,74,54,255],"outline":[207,74,54,0],"width":0.0}}},{"id":19,"name":"Rectangle","x":120.0,"y":233.0,"w":17.6,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[140,28,44,255],"outline":[140,28,44,0],"width":0.0}}},{"id":20,"name":"Text","x":11.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"−0.8 to −0.4","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":21,"name":"Text","x":29.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"−0.4 to 0","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":22,"name":"Text","x":47.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"0 to +0.5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":23,"name":"Text","x":65.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"+0.5 to +2.5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":24,"name":"Text","x":83.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"+2.5 to +5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":25,"name":"Text","x":101.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"+5 to +7.5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":26,"name":"Text","x":119.0,"y":236.6,"w":19.6,"h":3.0,"visible":true,"kind":{"Text":{"text":"over +7.5","size":5.8,"color":[78,70,60,255],"bold":false,"align":"Center"}}},{"id":27,"name":"Text","x":144.0,"y":232.0,"w":54.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"The faded circles are the same\ncalculation outside the country.","size":6.0,"color":[133,122,108,255],"bold":false,"italic":true}}},{"id":28,"name":"Text","x":12.0,"y":243.0,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"99.94 km","size":16.0,"color":[43,92,138,255],"bold":true}}},{"id":29,"name":"Text","x":12.0,"y":251.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"is what a 100 km road near Bogotá measures\non the map: the plane shrinks 0.6 m per km\n(0.8 on the −73° meridian).","size":6.8,"color":[43,38,32,255],"bold":false}}},{"id":30,"name":"Text","x":75.0,"y":243.0,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"101.03 km","size":16.0,"color":[140,28,44,255],"bold":true}}},{"id":31,"name":"Text","x":75.0,"y":251.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"is what the same road measures in San Andrés:\n10.3 m too many per kilometre, and areas\ngrow by 2.08%.","size":6.8,"color":[43,38,32,255],"bold":false}}},{"id":32,"name":"Text","x":138.0,"y":243.0,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"254 km","size":16.0,"color":[43,38,32,255],"bold":true}}},{"id":33,"name":"Text","x":138.0,"y":251.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"on each side of the −73° meridian, the map is\nexact: two bands crossing the country from north\nto south, between what shrinks and what stretches.","size":6.8,"color":[43,38,32,255],"bold":false}}},{"id":34,"name":"Line","x":12.0,"y":265.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[205,191,174,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":35,"name":"Text","x":12.0,"y":266.5,"w":186.0,"h":12.5,"visible":true,"kind":{"Text":{"text":"Notes: Tissot circles of 20 km radius every 0.5°, with the scale factor k that RustGIS computes for the National Origin (Transverse Mercator, −73° meridian,\nk = 0.9992); the colour is (k − 1) × 1,000. The projection is conformal: the error is the same in every direction, and the area error is twice as large.\nBefore 2020 Colombia used five Gauss-Krüger origins, 3° bands with no more than 0.35 m/km of error, but five coordinate systems. Map at 1:10,500,000.\nData: DANE, National Geostatistical Framework 2025 (departments); IGAC, Resolution 471 of 2020 (National Origin).","size":5.6,"color":[133,122,108,255],"bold":false}}},{"id":36,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Day 22: Projections · Made with RustGIS · rustgis.app","size":6.5,"color":[78,70,60,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":37}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}