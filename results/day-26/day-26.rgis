{"fill":[14,23,48,255],"stroke":[38,54,92,255],"stroke_width":0.6,"size":0.0,"marker":"Circle"}},"labels":{"enabled":false,"field":"","size":10.0,"color":[43,43,43,255],"halo":true,"bold":false,"min_scale":null,"max_scale":null,"closest":null,"farthest":null,"placement":"Auto"},"transparency":0.0,"min_scale":null,"max_scale":null,"definition_query":null,"selection":[],"expanded":true,"selectable":true,"graphics":false,"blend":"Normal","mask":null,"display_filters":[],"aggregation":null,"extrusion":null,"priority":0,"geometry_rev":0}],"basemap":"Blank","paper":[7,11,22,255],"camera":{"center":{"x":-8126322.82790897,"y":468937.7088184901},"res":2837.152291210429,"bearing":0.0,"pitch":0.0},"bookmarks":[],"graticule":false,"projection":"WebMercator","popup_mode":"Topmost","label_display":{"paused":false,"locked":false,"show_unplaced":false},"editing":{"relationships":[],"snapping":{"enabled":false,"tolerance_px":10.0,"vertex":true,"edge":true,"end":true},"topology":[],"settings":{"enabled":true,"show_vertices":true,"elevation":"None","ground_to_grid":null}},"swipe":null,"view":{"effects":{"stars":true,"sun_time":null,"weather":"None","vignette":false,"edges":false,"tilt_shift":false,"grain":false,"brightness":0.0,"contrast":0.0,"saturation":0.0,"sepia":0.0},"wireframe":false,"clip_distance":null,"terrain":null},"animation":[],"next_layer_id":6}],"active_map":0,"tables":[],"next_table_id":1,"gp_history":[],"layouts":[{"name":"Dia 26 Colombia","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[7,11,22,255],"outline":[7,11,22,0],"width":0.0}}},{"id":2,"name":"Map Frame","x":10.0,"y":38.0,"w":190.0,"h":210.0,"visible":true,"kind":{"MapFrame":{"map":"Colombia","center":{"x":-73.0,"y":4.1},"scale":9000000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":10.0,"y":7.0,"w":190.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DÍA 26 · WATER · COLOMBIA","size":7.5,"color":[0,229,255,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":10.0,"y":12.0,"w":190.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Tanta agua, y sin agua en la casa","size":22.0,"color":[255,255,255,255],"bold":true}}},{"id":5,"name":"Text","x":10.0,"y":24.0,"w":190.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Colombia es el sexto país del mundo en agua dulce. Aun así, en 236 municipios la mayoría de las viviendas no tiene\nacueducto, y varios están a la orilla de los ríos más grandes del país.","size":9.0,"color":[201,210,222,255],"bold":false}}},{"id":6,"name":"Text","x":10.0,"y":250.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"6.º","size":20.0,"color":[0,229,255,255],"bold":true}}},{"id":7,"name":"Text","x":10.0,"y":259.5,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"país del mundo en agua dulce renovable:\n2.145 km³ al año (FAO, 2020).","size":7.0,"color":[201,210,222,255],"bold":false}}},{"id":8,"name":"Text","x":75.0,"y":250.0,"w":65.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"236 municipios","size":20.0,"color":[255,61,184,255],"bold":true}}},{"id":9,"name":"Text","x":75.0,"y":259.5,"w":65.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"donde la mayoría de las viviendas no tiene\nacueducto; 1,8 millones en todo el país (Censo 2018).","size":7.0,"color":[201,210,222,255],"bold":false}}},{"id":10,"name":"Text","x":145.0,"y":250.0,"w":55.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Ríos","size":9.0,"color":[0,229,255,255],"bold":true}}},{"id":11,"name":"Text","x":145.0,"y":255.5,"w":55.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"más gruesos y brillantes, más caudal:\nde 10 a más de 5000 m³/s de media.","size":7.0,"color":[201,210,222,255],"bold":false}}},{"id":12,"name":"Line","x":10.0,"y":270.0,"w":190.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[28,38,64,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":13,"name":"Text","x":10.0,"y":271.5,"w":190.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: RustGIS web (web.rustgis.app), con tres scripts; los datos van embebidos. Ríos con caudal medio de 10 m³/s o más, en cuatro clases.\nDatos: HydroRIVERS v1.0 (Lehner y Grill, 2013; HydroSHEDS). Viviendas sin servicio de acueducto: DANE, Censo Nacional de Población y Vivienda 2018,\nMarco Geoestadístico Nacional. Agua dulce renovable interna: Banco Mundial y FAO AQUASTAT (2020).","size":5.6,"color":[140,151,166,255],"bold":false}}},{"id":14,"name":"Text","x":10.0,"y":286.0,"w":190.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Día 26: Water · Hecho con RustGIS · rustgis.app","size":6.5,"color":[201,210,222,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":15},{"name":"Day 26","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[7,11,22,255],"outline":[7,11,22,0],"width":0.0}}},{"id":2,"name":"Map Frame","x":10.0,"y":38.0,"w":190.0,"h":210.0,"visible":true,"kind":{"MapFrame":{"map":"Colombia","center":{"x":-73.0,"y":4.1},"scale":9000000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":10.0,"y":7.0,"w":190.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 26 · WATER · COLOMBIA","size":7.5,"color":[0,229,255,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":10.0,"y":12.0,"w":190.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"So much water, and none at home","size":22.0,"color":[255,255,255,255],"bold":true}}},{"id":5,"name":"Text","x":10.0,"y":24.0,"w":190.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Colombia ranks sixth in the world for fresh water. Yet in 236 municipalities most homes have no piped water,\nand several of them sit on the banks of the country's largest rivers.","size":9.0,"color":[201,210,222,255],"bold":false}}},{"id":6,"name":"Text","x":10.0,"y":250.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"6th","size":20.0,"color":[0,229,255,255],"bold":true}}},{"id":7,"name":"Text","x":10.0,"y":259.5,"w":60.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"country in the world for renewable fresh\nwater: 2,145 km³ a year (FAO, 2020).","size":7.0,"color":[201,210,222,255],"bold":false}}},{"id":8,"name":"Text","x":75.0,"y":250.5,"w":72.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"236 municipalities","size":18.0,"color":[255,61,184,255],"bold":true}}},{"id":9,"name":"Text","x":75.0,"y":259.5,"w":72.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"where most homes have no piped water;\n1.8 million homes nationwide (2018 Census).","size":7.0,"color":[201,210,222,255],"bold":false}}},{"id":10,"name":"Text","x":150.0,"y":250.0,"w":50.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Rivers","size":9.0,"color":[0,229,255,255],"bold":true}}},{"id":11,"name":"Text","x":150.0,"y":255.5,"w":50.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"thicker and brighter, more flow:\nfrom 10 to over 5,000 m³/s on average.","size":7.0,"color":[201,210,222,255],"bold":false}}},{"id":12,"name":"Line","x":10.0,"y":270.0,"w":190.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[28,38,64,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":13,"name":"Text","x":10.0,"y":271.5,"w":190.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"How it was made: RustGIS web (web.rustgis.app), with four scripts; the data is embedded. Rivers with a mean flow of 10 m³/s or more, in four classes.\nData: HydroRIVERS v1.0 (Lehner and Grill, 2013; HydroSHEDS). Homes without piped water (acueducto): DANE, 2018 National Population and Housing\nCensus, National Geostatistical Framework. Renewable internal fresh water: World Bank and FAO AQUASTAT (2020).","size":5.6,"color":[140,151,166,255],"bold":false}}},{"id":14,"name":"Text","x":10.0,"y":286.0,"w":190.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Day 26: Water · Made with RustGIS · rustgis.app","size":6.5,"color":[201,210,222,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":15}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}