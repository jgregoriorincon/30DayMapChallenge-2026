:[74,88,102,255],"bold":false}}},{"id":31,"name":"Rectangle","x":82.49,"y":212.4,"w":3.51,"h":3.6,"visible":true,"kind":{"Rectangle":{"fill":[230,225,234,255],"outline":[138,130,150,255],"width":0.3}}},{"id":32,"name":"Rectangle","x":124.0,"y":212.4,"w":27.0,"h":3.6,"visible":true,"kind":{"Rectangle":{"fill":[126,69,154,255],"outline":[126,69,154,0],"width":0.0}}},{"id":33,"name":"Text","x":86.0,"y":212.6,"w":38.0,"h":3.4,"visible":true,"kind":{"Text":{"text":"Metropolitana","size":6.5,"color":[31,35,40,255],"bold":true,"align":"Center"}}},{"id":34,"name":"Text","x":69.49,"y":212.7,"w":12.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"3.3","size":6.0,"color":[74,88,102,255],"bold":false,"align":"Right"}}},{"id":35,"name":"Text","x":152.0,"y":212.7,"w":12.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"25.7","size":6.0,"color":[74,88,102,255],"bold":false}}},{"id":36,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 20 · HEXAGONS · BARRANQUILLA","size":7.5,"color":[69,29,107,255],"bold":false,"letter_spacing":2.5}}},{"id":37,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"The city lives in the south and works in the north","size":22.0,"color":[31,35,40,255],"bold":true}}},{"id":38,"name":"Text","x":12.0,"y":21.5,"w":186.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"Each hexagon is a cell of Barranquilla's official population grid (0.29 km²). Its height is the number of active\nbusinesses in it; its colour, the number of people who live in it.","size":8.5,"color":[74,88,102,255],"bold":false}}},{"id":39,"name":"Text","x":12.0,"y":29.5,"w":32.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"People per hexagon","size":6.5,"color":[31,35,40,255],"bold":false}}},{"id":40,"name":"Rectangle","x":44.0,"y":30.0,"w":9.0,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[246,239,247,255],"outline":[191,182,196,255],"width":0.3}}},{"id":41,"name":"Rectangle","x":53.0,"y":30.0,"w":9.0,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[212,185,218,255],"outline":[212,185,218,0],"width":0.0}}},{"id":42,"name":"Rectangle","x":62.0,"y":30.0,"w":9.0,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[176,122,184,255],"outline":[176,122,184,0],"width":0.0}}},{"id":43,"name":"Rectangle","x":71.0,"y":30.0,"w":9.0,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[126,69,154,255],"outline":[126,69,154,0],"width":0.0}}},{"id":44,"name":"Rectangle","x":80.0,"y":30.0,"w":9.0,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[69,29,107,255],"outline":[69,29,107,0],"width":0.0}}},{"id":45,"name":"Text","x":48.0,"y":32.6,"w":10.0,"h":2.6,"visible":true,"kind":{"Text":{"text":"1,500","size":5.5,"color":[107,114,128,255],"bold":false,"align":"Center"}}},{"id":46,"name":"Text","x":66.0,"y":32.6,"w":10.0,"h":2.6,"visible":true,"kind":{"Text":{"text":"5,400","size":5.5,"color":[107,114,128,255],"bold":false,"align":"Center"}}},{"id":47,"name":"Text","x":75.0,"y":32.6,"w":10.0,"h":2.6,"visible":true,"kind":{"Text":{"text":"7,400","size":5.5,"color":[107,114,128,255],"bold":false,"align":"Center"}}},{"id":48,"name":"Text","x":81.0,"y":32.6,"w":10.0,"h":2.6,"visible":true,"kind":{"Text":{"text":"17,000","size":5.5,"color":[107,114,128,255],"bold":false,"align":"Right"}}},{"id":49,"name":"Line","x":100.0,"y":29.5,"w":0.5,"h":4.0,"visible":true,"kind":{"Line":{"color":[107,114,128,255],"width":1.2,"dir":"Vertical","head":"None"}}},{"id":50,"name":"Text","x":102.0,"y":29.5,"w":96.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Height: active businesses in the hexagon (4 m per business; the tallest tower, 626)","size":6.5,"color":[31,35,40,255],"bold":false}}},{"id":51,"name":"Text","x":12.0,"y":224.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"77%","size":20.0,"color":[69,29,107,255],"bold":true}}},{"id":52,"name":"Text","x":12.0,"y":233.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"of active businesses are in Riomar and\nNorte-centro histórico, home to 20% of\nthe people.","size":7.0,"color":[31,35,40,255],"bold":false}}},{"id":53,"name":"Text","x":75.0,"y":224.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"626","size":20.0,"color":[69,29,107,255],"bold":true}}},{"id":54,"name":"Text","x":75.0,"y":233.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"businesses in the fullest hexagon, in\nNorte-centro histórico: the tallest tower\non the map, in 0.29 km².","size":7.0,"color":[31,35,40,255],"bold":false}}},{"id":55,"name":"Text","x":138.0,"y":224.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"1,349,524","size":20.0,"color":[69,29,107,255],"bold":true}}},{"id":56,"name":"Text","x":138.0,"y":233.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"people in the district's 310 hexagons,\nand 22,436 active businesses. The south\nbrings the people; the north, the businesses.","size":7.0,"color":[31,35,40,255],"bold":false}}},{"id":57,"name":"Line","x":12.0,"y":248.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[207,200,214,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":58,"name":"Text","x":12.0,"y":249.5,"w":186.0,"h":11.5,"visible":true,"kind":{"Text":{"text":"The pale towers are the north and the centre: many businesses, few people. The flat purple hexagons are Metropolitana,\nSuroccidente and Suroriente: many people, hardly any businesses. Most people live where the businesses are not.\nThe hexagons were not generated here: they are the grid the city government publishes its population on.","size":7.0,"color":[74,88,102,255],"bold":false,"italic":true}}},{"id":59,"name":"Line","x":12.0,"y":268.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[207,200,214,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":60,"name":"Text","x":12.0,"y":269.0,"w":186.0,"h":16.5,"visible":true,"kind":{"Text":{"text":"Notes: 2025 population modelled by the city government on its hexagonal grid (0.28867 km² per whole cell); cells whose centre falls in the district are\ncounted (310 of 630). Businesses: register of active businesses, counted per cell with Summarize Within; a business on a shared edge counts in\nboth cells. Cells with no businesses and fewer than 500 people are hidden. Height: 4 m per business.\nEdge cells come clipped to the district boundary in the city government's grid.\nData: Alcaldía de Barranquilla (CC BY-SA 4.0), Mi Ciudad, accessed 2026-11-18: Densidad poblacional 2025, Empresas vigentes, Localidades.\nBasemap: Mi Ciudad. How it was made: all in RustGIS web (web.rustgis.app), with four scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.0,"color":[107,114,128,255],"bold":false}}},{"id":61,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY-SA 4.0 · #30DayMapChallenge 2026 · Day 20: Hexagons · Made with RustGIS · rustgis.app","size":6.5,"color":[74,88,102,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":62}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}