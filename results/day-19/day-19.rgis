"Text":{"text":"30DAYMAPCHALLENGE · DAY 19 · SMELL · SABANA DE BOGOTÁ","size":7.5,"color":[194,24,91,255],"bold":false,"letter_spacing":2.5}}},{"id":19,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"This is where the flowers come from","size":26.0,"color":[43,38,32,255],"bold":true}}},{"id":20,"name":"Text","x":12.0,"y":22.5,"w":186.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Greenhouse crops west of Bogotá, 2024, and where the wind carries them","size":9.0,"color":[78,70,60,255],"bold":false}}},{"id":21,"name":"Rectangle","x":12.0,"y":30.5,"w":6.0,"h":3.4,"visible":true,"kind":{"Rectangle":{"fill":[194,24,91,255],"outline":[194,24,91,0],"width":0.0}}},{"id":22,"name":"Text","x":20.0,"y":30.3,"w":38.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Greenhouse crops","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":23,"name":"Rectangle","x":58.0,"y":30.5,"w":6.0,"h":3.4,"visible":true,"kind":{"Rectangle":{"fill":[179,169,157,255],"outline":[179,169,157,0],"width":0.0}}},{"id":24,"name":"Text","x":66.0,"y":30.3,"w":26.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Cities and towns","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":25,"name":"Rectangle","x":92.0,"y":30.5,"w":6.0,"h":3.4,"visible":true,"kind":{"Rectangle":{"fill":[167,199,214,255],"outline":[167,199,214,0],"width":0.0}}},{"id":26,"name":"Text","x":100.0,"y":30.3,"w":30.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Reservoirs and lakes","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":27,"name":"Line","x":130.0,"y":32.0,"w":6.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[194,24,91,179],"width":0.7,"dir":"Horizontal","head":"None"}}},{"id":28,"name":"Text","x":138.0,"y":30.3,"w":58.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Scent contours","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":29,"name":"Rectangle","x":12.0,"y":178.5,"w":84.0,"h":34.5,"visible":true,"kind":{"Rectangle":{"fill":[241,234,223,242],"outline":[241,234,223,0],"width":0.0}}},{"id":30,"name":"Text","x":14.0,"y":179.5,"w":40.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"46%","size":24.0,"color":[194,24,91,255],"bold":true}}},{"id":31,"name":"Text","x":14.0,"y":190.5,"w":80.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"WEST · MADRID, FACATATIVÁ, EL ROSAL AND FUNZA","size":6.0,"color":[194,24,91,255],"bold":true,"letter_spacing":1.0}}},{"id":32,"name":"Text","x":14.0,"y":194.5,"w":80.0,"h":10.5,"visible":true,"kind":{"Text":{"text":"of the savanna's hectares: 4,442, in some\n23 × 21 km. The wind blows west (282°)\nthree hours in four.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":33,"name":"Scale Bar","x":14.0,"y":206.0,"w":40.0,"h":5.5,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[133,122,108,255],"fill":[255,255,255,255]}}},{"id":34,"name":"North Arrow","x":58.0,"y":205.0,"w":3.5,"h":6.5,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[133,122,108,255],"outline":[133,122,108,255]}}},{"id":35,"name":"Text","x":12.0,"y":216.0,"w":62.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"6 in 10","size":20.0,"color":[194,24,91,255],"bold":true}}},{"id":36,"name":"Text","x":12.0,"y":226.0,"w":62.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"dollars the United States paid for imported\nflowers in 2024 went to Colombia:\n1,240 of 1,980 million.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":37,"name":"Text","x":12.0,"y":238.5,"w":62.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"If someone there smells imported flowers,\nthey most likely come from Colombia. And\nin Colombia, mostly from here.","size":7.0,"color":[78,70,60,255],"bold":false,"italic":true}}},{"id":38,"name":"Text","x":12.0,"y":251.0,"w":62.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Cundinamarca and Bogotá have 9,629 ha under\ngreenhouses, two in three in the country. The\nnorth, Zipaquirá to Suesca, adds another 27%.","size":7.0,"colo