ible":true,"kind":{"Text":{"text":"Embalses y lagunas","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":27,"name":"Line","x":130.0,"y":32.0,"w":6.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[194,24,91,179],"width":0.7,"dir":"Horizontal","head":"None"}}},{"id":28,"name":"Text","x":138.0,"y":30.3,"w":58.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Curvas del aroma","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":29,"name":"Rectangle","x":12.0,"y":178.5,"w":84.0,"h":34.5,"visible":true,"kind":{"Rectangle":{"fill":[241,234,223,242],"outline":[241,234,223,0],"width":0.0}}},{"id":30,"name":"Text","x":14.0,"y":179.5,"w":40.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"46 %","size":24.0,"color":[194,24,91,255],"bold":true}}},{"id":31,"name":"Text","x":14.0,"y":190.5,"w":80.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"OESTE · MADRID, FACATATIVÁ, EL ROSAL Y FUNZA","size":6.0,"color":[194,24,91,255],"bold":true,"letter_spacing":1.0}}},{"id":32,"name":"Text","x":14.0,"y":194.5,"w":80.0,"h":10.5,"visible":true,"kind":{"Text":{"text":"de las hectáreas de la Sabana: 4 442, en unos\n23 × 21 km. El viento sopla hacia el oeste\n(282°) en 3 de cada 4 horas.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":33,"name":"Scale Bar","x":14.0,"y":206.0,"w":40.0,"h":5.5,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[133,122,108,255],"fill":[255,255,255,255]}}},{"id":34,"name":"North Arrow","x":58.0,"y":205.0,"w":3.5,"h":6.5,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[133,122,108,255],"outline":[133,122,108,255]}}},{"id":35,"name":"Text","x":12.0,"y":216.0,"w":62.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"6 de cada 10","size":20.0,"color":[194,24,91,255],"bold":true}}},{"id":36,"name":"Text","x":12.0,"y":226.0,"w":62.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"dólares que Estados Unidos pagó por flores\nimportadas en 2024 fueron a Colombia:\n1 240 de 1 980 millones.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":37,"name":"Text","x":12.0,"y":238.5,"w":62.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Si allá alguien huele flores importadas, lo\nmás probable es que vengan de Colombia. Y\nen Colombia, sobre todo de aquí.","size":7.0,"color":[78,70,60,255],"bold":false,"italic":true}}},{"id":38,"name":"Text","x":12.0,"y":251.0,"w":62.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Cundinamarca y Bogotá tienen 9 629 ha bajo\ninvernadero, dos de cada tres del país. El\nnorte, de Zipaquirá a Suesca, suma otro 27 %.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":39,"name":"Text","x":80.0,"y":217.0,"w":58.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"HECTÁREAS, POR MUNICIPIO","size":6.0,"color":[194,24,91,255],"bold":true,"letter_spacing":1.0}}},{"id":40,"name":"Text","x":80.0,"y":222.5,"w":19.0,"h":3.6,"visible":true,"kind":{"Text":{"text":"Madrid","size":6.3,"color":[43,38,32,255],"bold":false,"align":"Right"}}},{"id":41,"name":"Rectangle","x":101.0,"y":222.8,"w":24.0,"h":3.2,"visible":true,"kind":{"Rectangle":{"fill":[194,24,91,255],"outline":[194,24,91,0],"width":0.0}}},{"id":42,"name":"Text","x":126.2,"y":222.6,"w":12.0,"h":3.4,"visible":true,"kind":{"Text":{"text":"2 095","size":6.0,"color":[78,70,60,255],"bold":false}}},{"id":43,"name":"Text","x":80.0,"y":227.9,"w":19.0,"h":3.6,"visible":true,"kind":{"Text":{"text":"Facatativá","size":6.3,"color":[43,38,32,255],"bold":false,"align":"Right"}}},{"id":44,"name":"Rectangle","x":101.0,"y":228.20000000000002,"w":10.25,"h":3.2,"visible":true,"kind":{"Rectangle":{"fill":[194,24,91,255],"outline":[194,24,91,0],"width":0.0}}},{"id":45,"name":"Text","x":112.45,"y":228.0,"w":12.0,"h":3.4,"visible":true,"kind":{"Text":{"text":"895","size":6.0,"color":[78,70,60,255],"bold":false}}},{"id":46,"name":"Text","x":80.0,"y":233.3,"w":19.0,"h":3.6,"visible":true,"kind":{"Text":{"text":"El Rosal","size":6.3,"color":[43,38,32,255],"bold":false,"align":"Right"}}},{"