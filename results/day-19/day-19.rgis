ay 19: Senses: Smell · Made with RustGIS · rustgis.app","size":6.5,"color":[78,70,60,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":81}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}