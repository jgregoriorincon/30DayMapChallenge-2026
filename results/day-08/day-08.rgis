":"https://www.medellin.gov.co/servidormapas/rest/services/Hosted/CartografiaBase_ZER_VectorTile/VectorTileServer/resources/styles/root.json","minZoom":0,"maxZoom":14,"tileSize":256,"attribution":"Mapa base: Alcaldía de Medellín","visible":true,"opacity":1.0}],"camera":{"center":{"x":-8413360.134919427,"y":696487.4643396322},"res":22.58900145311829,"bearing":0.0,"pitch":0.0},"bookmarks":[],"graticule":true,"projection":"WebMercator","popup_mode":"Topmost","label_display":{"paused":false,"locked":false,"show_unplaced":false},"editing":{"relationships":[],"snapping":{"enabled":false,"tolerance_px":10.0,"vertex":true,"edge":true,"end":true},"topology":[],"settings":{"enabled":true,"show_vertices":true,"elevation":"None","ground_to_grid":null}},"swipe":null,"view":{"effects":{"stars":true,"sun_time":null,"weather":"None","vignette":false,"edges":false,"tilt_shift":false,"grain":false,"brightness":0.0,"contrast":0.0,"saturation":0.0,"sepia":0.0},"wireframe":false,"clip_distance":null,"terrain":null},"animation":[],"next_layer_id":14}],"active_map":0,"tables":[],"next_table_id":1,"gp_history":[{"tool":"Zonal Statistics","id":"zonalStats","params":{"bands":"1","output":"Vegetación · Vegetation","polygons":"Comunas","prefix":"veg","raster":"Vegetación (NDVI > 0,3)","stats":"Mean"},"at":1794066671,"ok":true,"messages":["Calculated zonal statistics for 16 feature(s)"],"millis":43,"outputs":["Vegetación · Vegetation"]},{"tool":"Merge","id":"merge","params":{"attributes":true,"inputs":"Manzanas 1;Manzanas 2;Manzanas 3;Manzanas 4;Manzanas 5","output":"Manzanas unidas"},"at":1794066680,"ok":true,"messages":["Merge: 9656 features from 5 layers"],"millis":4,"outputs":["Manzanas unidas"]},{"tool":"Simplify","id":"simplify","params":{"input":"Manzanas unidas","output":"Manzanas","tolerance":0.001},"at":1794066680,"ok":true,"messages":["Simplify: 865700 → 250279 vertices"],"millis":232,"outputs":["Manzanas"]},{"tool":"Simplify","id":"simplify","params":{"input":"Parques","output":"Parques ≥ 0,5 ha · Parks ≥ 0.5 ha","tolerance":0.001},"at":1794066680,"ok":true,"messages":["Simplify: 82090 → 18726 vertices"],"millis":26,"outputs":["Parques ≥ 0,5 ha · Parks ≥ 0.5 ha"]},{"tool":"Near","id":"near","params":{"input":"Manzanas","near":"Parques ≥ 0,5 ha · Parks ≥ 0.5 ha","output":"Manzanas · Blocks","units":"Meters"},"at":1794066680,"ok":true,"messages":["Near: 9656 of 9656 features have a near feature"],"millis":14190,"outputs":["Manzanas · Blocks"]}],"layouts":[{"name":"Dia 08","width":297.0,"height":210.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":37.0,"w":102.0,"h":128.0,"visible":true,"kind":{"MapFrame":{"map":"El 30","center":{"x":-75.57856369299998,"y":6.244301392413977},"scale":131069.2902393659,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Map Frame","x":118.0,"y":37.0,"w":102.0,"h":128.0,"visible":true,"kind":{"MapFrame":{"map":"El 300","center":{"x":-75.57856369299998,"y":6.244301392413977},"scale":131069.2902393659,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":10.0,"y":7.0,"w":277.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"La utopía del 3-30-300 en Medellín","size":22.0,"color":[31,41,55,255],"bold":true}}},{"id":4,"name":"Text","x":10.0,"y":18.5,"w":277.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Regla de urbanismo verde (Konijnendijk, 2021): 3 árboles visibles desde cada casa, 30 % de copa arbórea en cada barrio y un parque a menos de 300 m.\nCon datos públicos se miden dos: 6 de las 16 comunas pasan del 30 % de vegetación y 7 de cada 10 manzanas tienen un parque a 300 m o menos.","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":5,"name":"Text","x":10.0,"y":31.0,"w":102.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"30 · Vegetación por comuna (NDVI de la ortofoto 2024)","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":6,"name":"Text","x":118.0,"y":31.0,"w":102.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"300 · Cada manzana y su parque más cercano de al menos 0,5 ha","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":7,"name":"Rectangle","x":96.5,"y":39.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":8,"name":"North Arrow","x":98.0,"y":40.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":9,"name":"Rectangle","x":11.0,"y":155.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":10,"name":"Scale Bar","x":13.0,"y":157.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[34,34,34,255],"fill":[255,255,255,255]}}},{"id":11,"name":"Legend","x":10.0,"y":167.0,"w":100.0,"h":18.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false,"exclude":["Comunas"],"columns":2}}},{"id":12,"name":"Legend","x":118.0,"y":167.0,"w":100.0,"h":18.0,"visible":true,"kind":{"Legend":{"frame":2,"title":" ","all_classes":false,"hide_other":false,"exclude":["Comunas"],"columns":2}}},{"id":13,"name":"Text","x":228.0,"y":37.0,"w":59.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"¿Y el 3?","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":14,"name":"Text","x":228.0,"y":43.0,"w":59.0,"h":24.0,"visible":true,"kind":{"Text":{"text":"Ver 3 árboles desde cada casa no se\npuede medir con datos públicos: el\ninventario de árboles de Medellín\nregistra intervenciones, no todos los\nárboles, y lo que se ve desde una\nventana pide imágenes de calle.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":15,"name":"Text","x":228.0,"y":74.0,"w":59.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Por comuna","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":16,"name":"Text","x":228.0,"y":80.0,"w":59.0,"h":24.0,"visible":true,"kind":{"Text":{"text":"Pasan del 30 %: El Poblado (52 %),\nBuenos Aires (43 %), Robledo (41 %),\nBelén (34 %), Villa Hermosa (34 %)\ny Guayabal (31 %).\nLas menos verdes: Santa Cruz y Doce\nde Octubre, con 13 % cada una.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":17,"name":"Text","x":228.0,"y":111.0,"w":59.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Al leerlo","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":18,"name":"Text","x":228.0,"y":117.0,"w":59.0,"h":28.0,"visible":true,"kind":{"Text":{"text":"El NDVI cuenta toda la vegetación:\nárboles, prados y jardines. Guayabal\nsuma el pasto del aeropuerto Olaya\nHerrera. Es una aproximación a la\ncopa, no la copa.\nLos 300 m son en línea recta, de\nborde a borde, no caminando.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":19,"name":"Text","x":10.0,"y":188.0,"w":277.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: todo en RustGIS web (web.rustgis.app), con cuatro scripts. 1 · Datos: comunas, parques, manzanas y una imagen de vegetación (NDVI > 0,3) que el servidor de la Alcaldía calcula de la ortofoto 2024.\n2 · Vista: Zonal Statistics (la media por comuna es su % de vegetación), Merge, Simplify y Near (distancia de cada manzana al parque más cercano). 3–4 · Layouts. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":20,"name":"Text","x":10.0,"y":196.0,"w":277.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Datos: Alcaldía de Medellín, Departamento Administrativo de Planeación (GeoMedellín), CC BY-SA 4.0: ortofoto de noviembre de 2024, manzanas, espacio público existente y comunas;\nconsultado el 2026-11-07. Mapa base: Alcaldía de Medellín. Este mapa y su proyecto: CC BY-SA 4.0.","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":21,"name":"Text","x":10.0,"y":203.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 8: Utopia · Hecho con RustGIS · rustgis.app","size":7.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":22},{"name":"Day 08","width":297.0,"height":210.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":37.0,"w":102.0,"h":128.0,"visible":true,"kind":{"MapFrame":{"map":"El 30","center":{"x":-75.57856369299998,"y":6.244301392413977},"scale":131069.2902393659,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Map Frame","x":118.0,"y":37.0,"w":102.0,"h":128.0,"visible":true,"kind":{"MapFrame":{"map":"El 300","center":{"x":-75.57856369299998,"y":6.244301392413977},"scale":131069.2902393659,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":10.0,"y":7.0,"w":277.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"The 3-30-300 utopia in Medellín","size":22.0,"color":[31,41,55,255],"bold":true}}},{"id":4,"name":"Text","x":10.0,"y":18.5,"w":277.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"A green urban planning rule (Konijnendijk, 2021): 3 trees in view from every home, 30 % tree canopy in every neighbourhood and a park within 300 m.\nPublic data can measure two of them: 6 of the 16 comunas pass 30 % vegetation, and 7 in 10 city blocks have a park within 300 m.","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":5,"name":"Text","x":10.0,"y":31.0,"w":102.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"30 · Vegetation by comuna (NDVI from the 2024 orthophoto)","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":6,"name":"Text","x":118.0,"y":31.0,"w":102.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"300 · Each city block and its nearest park of at least 0.5 ha","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":7,"name":"Rectangle","x":96.5,"y":39.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":8,"name":"North Arrow","x":98.0,"y":40.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":9,"name":"Rectangle","x":11.0,"y":155.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":10,"name":"Scale Bar","x":13.0,"y":157.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[34,34,34,255],"fill":[255,255,255,255]}}},{"id":11,"name":"Legend","x":10.0,"y":167.0,"w":100.0,"h":18.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false,"exclude":["Comunas"],"columns":2}}},{"id":12,"name":"Legend","x":118.0,"y":167.0,"w":100.0,"h":18.0,"visible":true,"kind":{"Legend":{"frame":2,"title":" ","all_classes":false,"hide_other":false,"exclude":["Comunas"],"columns":2}}},{"id":13,"name":"Text","x":228.0,"y":37.0,"w":59.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"And the 3?","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":14,"name":"Text","x":228.0,"y":43.0,"w":59.0,"h":24.0,"visible":true,"kind":{"Text":{"text":"Seeing 3 trees from every home can't\nbe measured with public data: Medellín's\ntree inventory records the work done\non trees, not every tree, and what you\nsee from a window needs street-level\nimagery.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":15,"name":"Text","x":228.0,"y":74.0,"w":59.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"By comuna","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":16,"name":"Text","x":228.0,"y":80.0,"w":59.0,"h":24.0,"visible":true,"kind":{"Text":{"text":"Above 30 %: El Poblado (52 %),\nBuenos Aires (43 %), Robledo (41 %),\nBelén (34 %), Villa Hermosa (34 %)\nand Guayabal (31 %).\nThe least green: Santa Cruz and Doce\nde Octubre, at 13 % each.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":17,"name":"Text","x":228.0,"y":111.0,"w":59.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Reading it","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":18,"name":"Text","x":228.0,"y":117.0,"w":59.0,"h":28.0,"visible":true,"kind":{"Text":{"text":"NDVI counts all vegetation: trees,\nlawns and gardens. Guayabal adds the\ngrass of Olaya Herrera airport. It\napproximates the canopy; it isn't\nthe canopy.\nThe 300 m are a straight line, edge\nto edge, not a walk.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":19,"name":"Text","x":10.0,"y":188.0,"w":277.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts. 1 · Data: comunas, parks, city blocks and a vegetation image (NDVI > 0.3) that the city's server computes from the 2024 orthophoto.\n2 · View: Zonal Statistics (each comuna's mean is its vegetation share), Merge, Simplify and Near (distance from each block to the nearest park). 3–4 · Layouts. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":20,"name":"Text","x":10.0,"y":196.0,"w":277.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Data: Alcaldía de Medellín, Administrative Department of Planning (GeoMedellín), CC BY-SA 4.0: November 2024 orthophoto, city blocks, existing public space and comunas;\naccessed 2026-11-07. Basemap: Alcaldía de Medellín. This map and its project: CC BY-SA 4.0.","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":21,"name":"Text","x":10.0,"y":203.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 8: Utopia · Made with RustGIS · rustgis.app","size":7.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":22}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}