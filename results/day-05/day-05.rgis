ull,"terrain":null},"animation":[],"next_layer_id":4}],"active_map":0,"tables":[],"next_table_id":1,"gp_history":[],"layouts":[{"name":"Dia 05","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-74.11,"y":4.650025623701519},"scale":232658.1593489041,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"¿Qué se ve desde Monserrate?","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Desde el santuario, a unos 3.150 m, se ven unos 375 km² de Bogotá: más de la mitad del suelo a 25 km","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"Rectangle","x":184.5,"y":30.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":5,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":6,"name":"Rectangle","x":11.0,"y":218.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":7,"name":"Scale Bar","x":13.0,"y":220.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line"}}},{"id":8,"name":"Text","x":10.0,"y":232.0,"w":58.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Desde la cima","size":13.0,"color":[31,41,55,255],"bold":false}}},{"id":9,"name":"Rectangle","x":11.0,"y":241.0,"w":6.0,"h":4.0,"visible":true,"kind":{"Rectangle":{"fill":[168,180,128,255],"outline":[34,34,34,255],"width":0.5}}},{"id":10,"name":"Text","x":20.0,"y":240.0,"w":48.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"Se ve","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":11,"name":"Legend","x":10.0,"y":246.0,"w":58.0,"h":12.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false,"exclude":["MDT Bogotá 2025","Lo que se ve"]}}},{"id":12,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":21.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: todo en RustGIS web (web.rustgis.app), con tres scripts.\n1 · Datos: el Modelo Digital de Terreno 2025 de IDECA recortado por el servidor (exportImage,\n     ~55 m), sobre el mapa base azul de IDECA, con su estilo oficial.\n2 · Vista: Visibility Analysis desde el santuario (2 m de altura, 25 km de radio) sobre el\n     terreno desnudo; relieve con Shaded Relief.\n3 · Layout: armado por script. Los scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":13,"name":"Text","x":72.0,"y":255.0,"w":128.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Datos: Modelo Digital de Terreno de Bogotá D.C. 2025 — IDECA (CC BY 4.0), consultado el\n2026-11-04. Sin edificios ni árboles: muestra lo que el relieve deja ver.\nMapa base: Mapa base azul, IDECA.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":14,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 5: Senses: Sight · Hecho con RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":15},{"name":"Day 05","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-74.11,"y":4.650025623701519},"scale":232658.1593489041,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"What can you see from Monserrate?","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"From the sanctuary, at about 3,150 m, you can see some 375 km² of Bogotá: over half the land within 25 km","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"Rectangle","x":184.5,"y":30.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":5,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":6,"name":"Rectangle","x":11.0,"y":218.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":7,"name":"Scale Bar","x":13.0,"y":220.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line"}}},{"id":8,"name":"Text","x":10.0,"y":232.0,"w":58.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"From the top","size":13.0,"color":[31,41,55,255],"bold":false}}},{"id":9,"name":"Rectangle","x":11.0,"y":241.0,"w":6.0,"h":4.0,"visible":true,"kind":{"Rectangle":{"fill":[168,180,128,255],"outline":[34,34,34,255],"width":0.5}}},{"id":10,"name":"Text","x":20.0,"y":240.0,"w":48.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"Visible","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":11,"name":"Legend","x":10.0,"y":246.0,"w":58.0,"h":12.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false,"exclude":["MDT Bogotá 2025","Lo que se ve"]}}},{"id":12,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":21.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts.\n1 · Data: IDECA's 2025 Digital Terrain Model, clipped by the server (exportImage, ~55 m),\n     on IDECA's blue basemap, with its official style.\n2 · View: Visibility Analysis from the sanctuary (2 m high, 25 km radius) on the bare\n     terrain; relief with Shaded Relief.\n3–4 · Layouts in Spanish and English, by script: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":13,"name":"Text","x":72.0,"y":255.0,"w":128.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Data: Digital Terrain Model of Bogotá D.C. 2025 — IDECA (CC BY 4.0), accessed\n2026-11-04. No buildings or trees: it shows what the relief lets you see.\nBasemap: Mapa base azul, IDECA.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":14,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 5: Senses: Sight · Made with RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":15}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}