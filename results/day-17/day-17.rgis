 GIBS, Gap-Filled BRDF Corrected Radiance (Day/Night Band, NOAA-20), 14 de enero de 2025. Departamentos: DANE, MGN 2025.\nCómo se hizo: todo en RustGIS web (web.rustgis.app): teselas de GIBS con la fecha en la dirección, tinte ámbar en multiply y máscara (Erase);\nun punto por municipio (Feature To Point) y círculos con el tamaño por expresión. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.5,"color":[127,138,153,255],"bold":false}}},{"id":48,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Día 17: Light & dark · Hecho con RustGIS · rustgis.app","size":6.5,"color":[255,196,107,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":49},{"name":"Day 17","width":210.0,"height":297.0,"elements":[{"id":2,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[7,9,15,255],"outline":[7,9,15,255],"width":0.0}}},{"id":1,"name":"Map Frame","x":0.0,"y":29.0,"w":210.0,"h":197.0,"visible":true,"kind":{"MapFrame":{"map":"Colombia","center":{"x":-73.05,"y":4.15},"scale":10000000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 17 · LIGHT & DARK · COLOMBIA","size":7.5,"color":[255,196,107,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Light does not reach the countryside","size":26.0,"color":[242,238,230,255],"bold":true}}},{"id":5,"name":"Text","x":12.0,"y":22.5,"w":186.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Colombia at night and, in cyan, each municipality's rural homes without electricity","size":9.0,"color":[184,192,204,255],"bold":false}}},{"id":6,"name":"Text","x":10.0,"y":34.0,"w":70.0,"h":15.0,"visible":true,"kind":{"Text":{"text":"1 in 5","size":34.0,"color":[0,229,255,255],"bold":true}}},{"id":7,"name":"Text","x":10.0,"y":50.0,"w":62.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"rural homes in Colombia\nhave no electricity service:\n1,027,113 out of 4,729,817.","size":7.5,"color":[230,236,245,255],"bold":false}}},{"id":8,"name":"Text","x":150.0,"y":38.0,"w":58.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"RURAL HOMES WITHOUT\nELECTRICITY, BY MUNICIPALITY","size":6.5,"color":[0,229,255,255],"bold":true,"letter_spacing":1.2}}},{"id":9,"name":"Circle","x":152.0,"y":48.96,"w":9.04,"h":9.04,"visible":true,"kind":{"Ellipse":{"fill":[0,229,255,115],"outline":[125,243,255,255],"width":0.3}}},{"id":10,"name":"Circle","x":167.5,"y":53.87,"w":4.13,"h":4.13,"visible":true,"kind":{"Ellipse":{"fill":[0,229,255,115],"outline":[125,243,255,255],"width":0.3}}},{"id":11,"name":"Circle","x":180.5,"y":56.59,"w":1.41,"h":1.41,"visible":true,"kind":{"Ellipse":{"fill":[0,229,255,115],"outline":[125,243,255,255],"width":0.3}}},{"id":12,"name":"Text","x":149.5,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"50,000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":13,"name":"Text","x":162.5,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"10,000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":14,"name":"Text","x":174.2,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"1,000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":15,"name":"Text","x":150.0,"y":64.5,"w":55.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Area is proportional to the homes.\nEach circle sits at a point inside the\nmunicipality, not where the homes are.","size":6.0,"color":[138,151,171,255],"bold":false}}},{"id":16,"name":"Text","x":150.0,"y":178.0,"w":55.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"THE CARIBBEAN, ALMOST HALF","size":6.5,"color":[0,229,255,255],"bold":true,"letter_spacing":1.2}}},{"id":17,"name":"Text","x":150.0,"y":182.5,"w":54.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"476,423 of those homes (46%)\nare in the Caribbean region. In\nUribia (La Guajira) alone, 49,180:\n95 in every 100 of its rural homes.","size":7.0,"color":[230,236,245,255],"bold":false}}},{"id":18,"name":"North Arrow","x":195.0,"y":203.0,"w":6.0,"h":9.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[138,151,171,255],"outline":[138,151,171,255]}}},{"id":19,"name":"Scale Bar","x":150.0,"y":214.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[138,151,171,255],"fill":[255,255,255,255]}}},{"id":20,"name":"Text","x":12.0,"y":229.5,"w":88.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"HOW TO READ IT","size":6.5,"color":[255,196,107,255],"bold":true,"letter_spacing":1.2}}},{"id":21,"name":"Text","x":12.0,"y":234.0,"w":90.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"The background is Colombia at night, seen by the\nNOAA-20 satellite on 14 January 2025. Towns and cities\nshine; the dark countryside can't be told apart at this\nscale, hence the circles: what the night does not show.","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":22,"name":"Text","x":108.0,"y":229.5,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"WHAT IT MEASURES","size":6.5,"color":[255,196,107,255],"bold":true,"letter_spacing":1.2}}},{"id":23,"name":"Text","x":108.0,"y":234.0,"w":90.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"UPME's electricity coverage index (2024): homes without\nservice = all homes − homes with service. Rural part only:\nin cities that difference is not always homes in the dark\n(Bogotá shows 209,930).","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":24,"name":"Text","x":12.0,"y":251.5,"w":186.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"RURAL HOMES WITHOUT ELECTRICITY · THE SEVEN DEPARTMENTS WITH THE MOST · CARIBBEAN ONES IN CYAN","size":6.5,"color":[0,229,255,255],"bold":true,"letter_spacing":1.2}}},{"id":25,"name":"Rectangle","x":16.25,"y":262.0,"w":18.0,"h":10.0,"visible":true,"kind":{"Rectangle":{"fill":[0,229,255,179],"outline":[0,229,255,179],"width":0.0}}},{"id":26,"name":"Text","x":12.0,"y":258.6,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"117,162","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":27,"name":"Text","x":12.0,"y":272.8,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"La Guajira","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":28,"name":"Rectangle","x":42.75,"y":264.71,"w":18.0,"h":7.29,"visible":true,"kind":{"Rectangle":{"fill":[0,229,255,179],"outline":[0,229,255,179],"width":0.0}}},{"id":29,"name":"Text","x":38.5,"y":261.31,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"85,434","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":30,"name":"Text","x":38.5,"y":272.8,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"Bolívar","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":31,"name":"Rectangle","x":69.25,"y":264.8,"w":18.0,"h":7.2,"visible":true,"kind":{"Rectangle":{"fill":[0,229,255,179],"outline":[0,229,255,179],"width":0.0}}},{"id":32,"name":"Text","x":65.0,"y":261.4,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"84,397","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":33,"name":"Text","x":65.0,"y":272.8,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"Córdoba","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":34,"name":"Rectangle","x":95.75,"y":265.46,"w":18.0,"h":6.54,"visible":true,"kind":{"Rectangle":{"fill":[91,107,130,255],"outline":[91,107,130,255],"width":0.0}}},{"id":35,"name":"Text","x":91.5,"y":262.06,"w":26.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"76,576","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":36,"name":"Text","x":91.5,"y":272.8,"w":26.5,"h":3.0,"visible":true,"kind":{"Te