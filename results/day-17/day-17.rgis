del campo colombiano\nno tiene servicio de energía eléctrica:\n1 027 113 de 4 729 817.","size":7.5,"color":[230,236,245,255],"bold":false}}},{"id":8,"name":"Text","x":150.0,"y":38.0,"w":55.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"VIVIENDAS RURALES SIN\nSERVICIO, POR MUNICIPIO","size":6.5,"color":[0,229,255,255],"bold":true,"letter_spacing":1.2}}},{"id":9,"name":"Circle","x":152.0,"y":48.96,"w":9.04,"h":9.04,"visible":true,"kind":{"Ellipse":{"fill":[0,229,255,115],"outline":[125,243,255,255],"width":0.3}}},{"id":10,"name":"Circle","x":167.5,"y":53.87,"w":4.13,"h":4.13,"visible":true,"kind":{"Ellipse":{"fill":[0,229,255,115],"outline":[125,243,255,255],"width":0.3}}},{"id":11,"name":"Circle","x":180.5,"y":56.59,"w":1.41,"h":1.41,"visible":true,"kind":{"Ellipse":{"fill":[0,229,255,115],"outline":[125,243,255,255],"width":0.3}}},{"id":12,"name":"Text","x":149.5,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"50 000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":13,"name":"Text","x":162.5,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"10 000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":14,"name":"Text","x":174.2,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"1 000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":15,"name":"Text","x":150.0,"y":64.5,"w":55.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"El área es proporcional a las viviendas.\nCada círculo va en un punto dentro del\nmunicipio, no donde están las casas.","size":6.0,"color":[138,151,171,255],"bold":false}}},{"id":16,"name":"Text","x":150.0,"y":178.0,"w":52.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"EL CARIBE, CASI LA MITAD","size":6.5,"color":[0,229,255,255],"bold":true,"letter_spacing":1.2}}},{"id":17,"name":"Text","x":150.0,"y":182.5,"w":54.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"476 423 de esas viviendas (46 %)\nestán en el Caribe. Solo en Uribia\n(La Guajira) son 49 180: 95 de cada\n100 de sus viviendas rurales.","size":7.0,"color":[230,236,245,255],"bold":false}}},{"id":18,"name":"North Arrow","x":195.0,"y":203.0,"w":6.0,"h":9.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[138,151,171,255],"outline":[138,151,171,255]}}},{"id":19,"name":"Scale Bar","x":150.0,"y":214.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[138,151,171,255],"fill":[255,255,255,255]}}},{"id":20,"name":"Text","x":12.0,"y":229.5,"w":88.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"CÓMO LEERLO","size":6.5,"color":[255,196,107,255],"bold":true,"letter_spacing":1.2}}},{"id":21,"name":"Text","x":12.0,"y":234.0,"w":90.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"El fondo es Colombia de noche, vista por el satélite\nNOAA-20 el 14 de enero de 2025. Brillan los pueblos\ny las ciudades; el campo sin luz no se distingue a esta\nescala, y por eso los círculos: lo que la noche no muestra.","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":22,"name":"Text","x":108.0,"y":229.5,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"QUÉ MIDE","size":6.5,"color":[255,196,107,255],"bold":true,"letter_spacing":1.2}}},{"id":23,"name":"Text","x":108.0,"y":234.0,"w":90.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"El índice de cobertura de la UPME (2024): viviendas sin\nservicio = viviendas totales − viviendas con servicio.\nSolo la parte rural: en las ciudades esa resta no siempre\nson casas a oscuras (Bogotá figura con 209 930).","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":24,"name":"Text","x":12.0,"y":251.5,"w":186.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"VIVIENDAS RURALES SIN SERVICIO · LOS SIETE DEPARTAMENTOS CON MÁS · EN CIAN, LOS DEL CARIBE","size":6.5,"color":[0,229,255,255],"bold":true,"letter_spacing":1.2}}},{"id":25,"name":"Rectangle","x":16.25,"y":262.0,"w":18.0,"h":10.0,"visible":true,"kind"