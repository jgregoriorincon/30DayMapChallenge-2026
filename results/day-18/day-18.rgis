},{"id":21,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 18 · NULL · COLOMBIA","size":7.5,"color":[154,163,174,255],"bold":false,"letter_spacing":2.5}}},{"id":22,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Whereabouts: blank","size":26.0,"color":[242,238,230,255],"bold":true}}},{"id":23,"name":"Text","x":12.0,"y":22.5,"w":186.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Victims of enforced disappearance in the armed conflict who are still missing, by municipality where it happened","size":9.0,"color":[184,192,204,255],"bold":false}}},{"id":24,"name":"Text","x":10.0,"y":34.0,"w":70.0,"h":15.0,"visible":true,"kind":{"Text":{"text":"75,733","size":34.0,"color":[255,255,255,255],"bold":true}}},{"id":25,"name":"Text","x":10.0,"y":50.0,"w":62.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"victims of enforced disappearance\nare still missing in Colombia.\nThe missing data is where they are.","size":7.5,"color":[230,236,245,255],"bold":false}}},{"id":26,"name":"Text","x":150.0,"y":38.0,"w":55.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"STILL MISSING,\nBY MUNICIPALITY","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":27,"name":"Circle","x":152.82,"y":50.64,"w":7.36,"h":7.36,"visible":true,"kind":{"Ellipse":{"fill":[255,255,255,20],"outline":[255,255,255,255],"width":0.3}}},{"id":28,"name":"Text","x":149.5,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"2,000","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":29,"name":"Circle","x":167.59,"y":54.19,"w":3.81,"h":3.81,"visible":true,"kind":{"Ellipse":{"fill":[255,255,255,20],"outline":[255,255,255,255],"width":0.3}}},{"id":30,"name":"Text","x":162.5,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"500","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":31,"name":"Circle","x":180.5,"y":56.61,"w":1.39,"h":1.39,"visible":true,"kind":{"Ellipse":{"fill":[255,255,255,20],"outline":[255,255,255,255],"width":0.3}}},{"id":32,"name":"Text","x":174.2,"y":59.5,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"50","size":6.0,"color":[230,236,245,255],"bold":false,"align":"Center"}}},{"id":33,"name":"Text","x":150.0,"y":64.5,"w":55.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Area is proportional to the victims.\nEach circle sits at a point inside the\nmunicipality, not where they vanished.","size":6.0,"color":[138,151,171,255],"bold":false}}},{"id":34,"name":"Circle","x":14.0,"y":98.0,"w":9.5,"h":9.5,"visible":true,"kind":{"Ellipse":{"fill":[255,255,255,20],"outline":[255,255,255,255],"width":0.3}}},{"id":35,"name":"Text","x":12.0,"y":110.0,"w":40.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"NO PLACE · 3,382","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":36,"name":"Text","x":12.0,"y":114.5,"w":40.0,"h":24.0,"visible":true,"kind":{"Text":{"text":"victims with no municipality\nor department. In the service\nthey all sit on one point,\n4° N 72° W, in the plains:\na fixed point that does not\nsay where they disappeared.","size":6.5,"color":[213,218,226,255],"bold":false}}},{"id":37,"name":"Text","x":150.0,"y":176.0,"w":55.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"OF 86,714 RECORDED VICTIMS","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":38,"name":"Text","x":150.0,"y":180.5,"w":55.0,"h":14.0,"visible":true,"kind":{"Text":{"text":"75,733 are still missing\n8,821 were found dead\n1,819 were found alive\n341 in seven other situations","size":7.0,"color":[230,236,245,255],"bold":false}}},{"id":39,"name":"North Arrow","x":195.0,"y":203.0,"w":6.0,"h":9.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[138,151,171,255],"outline":[138,151,171,255]}}},{"id":40,"name":"Scale Bar","x":150.0,"y":214.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[138,151,171,255],"fill":[255,255,255,255]}}},{"id":41,"name":"Text","x":12.0,"y":229.5,"w":88.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"HOW TO READ IT","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":42,"name":"Text","x":12.0,"y":234.0,"w":92.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"Each circle is a municipality; its area, the people still\nmissing from events that happened there. Empty on\npurpose: they are the place of what is missing. The point\nis the municipality's centre, not the exact site.","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":43,"name":"Text","x":108.0,"y":229.5,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"ALSO NOT ON THE MAP","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":44,"name":"Text","x":108.0,"y":234.0,"w":90.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"Besides the 3,382 with no place: 277 with only the\ndepartment, 65 at a border and 11 in Belén de Bajirá\nand Mapiripana, which are not in the MGN 2025.\nThe map places 71,998 in 996 municipalities.","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":45,"name":"Text","x":12.0,"y":251.5,"w":130.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"STILL MISSING · BY YEAR OF THE EVENT · 1980-2026","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":46,"name":"Text","x":128.0,"y":256.2,"w":70.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"Before 1980: 461 · No year: 3,917","size":6.0,"color":[138,151,171,255],"bold":false,"align":"Right"}}},{"id":47,"name":"Rectangle","x":12.45,"y":269.8,"w":3.06,"h":0.2,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":48,"name":"Text","x":9.45,"y":271.0,"w":9.06,"h":3.0,"visible":true,"kind":{"Text":{"text":"1980","size":5.5,"color":[138,151,171,255],"bold":false,"align":"Center"}}},{"id":49,"name":"Rectangle","x":16.41,"y":