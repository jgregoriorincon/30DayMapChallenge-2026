to, 4° N 72° O, en los\nLlanos: un punto fijo que\nno dice dónde desaparecieron.","size":6.5,"color":[213,218,226,255],"bold":false}}},{"id":37,"name":"Text","x":150.0,"y":176.0,"w":55.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"DE 86 714 VÍCTIMAS REGISTRADAS","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":38,"name":"Text","x":150.0,"y":180.5,"w":55.0,"h":14.0,"visible":true,"kind":{"Text":{"text":"75 733 siguen desaparecidas\n8 821 aparecieron muertas\n1 819 aparecieron vivas\n341 en otras siete situaciones","size":7.0,"color":[230,236,245,255],"bold":false}}},{"id":39,"name":"North Arrow","x":195.0,"y":203.0,"w":6.0,"h":9.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[138,151,171,255],"outline":[138,151,171,255]}}},{"id":40,"name":"Scale Bar","x":150.0,"y":214.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[138,151,171,255],"fill":[255,255,255,255]}}},{"id":41,"name":"Text","x":12.0,"y":229.5,"w":88.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"CÓMO LEERLO","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":42,"name":"Text","x":12.0,"y":234.0,"w":92.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"Cada círculo es un municipio; su área, las personas que\nsiguen desaparecidas por hechos ocurridos allí. Vacíos a\npropósito: son el lugar de lo que falta. El punto es el\ncentro del municipio, no el sitio exacto.","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":43,"name":"Text","x":108.0,"y":229.5,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"TAMPOCO ESTÁN EN EL MAPA","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":44,"name":"Text","x":108.0,"y":234.0,"w":90.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"Además de las 3 382 sin lugar: 277 con solo el\ndepartamento, 65 en una frontera y 11 en Belén de\nBajirá y Mapiripana, que no están en el MGN 2025.\nEl mapa ubica 71 998 en 996 municipios.","size":7.0,"color":[213,218,226,255],"bold":false}}},{"id":45,"name":"Text","x":12.0,"y":251.5,"w":130.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"SIGUEN DESAPARECIDAS · POR AÑO DEL HECHO · 1980-2026","size":6.5,"color":[255,255,255,255],"bold":true,"letter_spacing":1.2}}},{"id":46,"name":"Text","x":128.0,"y":256.2,"w":70.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"Antes de 1980: 461 · Sin año: 3 917","size":6.0,"color":[138,151,171,255],"bold":false,"align":"Right"}}},{"id":47,"name":"Rectangle","x":12.45,"y":269.8,"w":3.06,"h":0.2,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":48,"name":"Text","x":9.45,"y":271.0,"w":9.06,"h":3.0,"visible":true,"kind":{"Text":{"text":"1980","size":5.5,"color":[138,151,171,255],"bold":false,"align":"Center"}}},{"id":49,"name":"Rectangle","x":16.41,"y":269.66,"w":3.06,"h":0.34,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":50,"name":"Rectangle","x":20.36,"y":269.5,"w":3.06,"h":0.5,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":51,"name":"Rectangle","x":24.32,"y":269.45,"w":3.06,"h":0.55,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":52,"name":"Rectangle","x":28.28,"y":269.37,"w":3.06,"h":0.63,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":53,"name":"Rectangle","x":32.24,"y":268.55,"w":3.06,"h":1.45,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":54,"name":"Rectangle","x":36.19,"y":267.95,"w":3.06,"h":2.05,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.0}}},{"id":55,"name":"Rectangle","x":40.15,"y":268.04,"w":3.06,"h":1.96,"visible":true,"kind":{"Rectangle":{"fill":[138,147,160,255],"outline":[0,0,0,0],"width":0.