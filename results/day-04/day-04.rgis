"]}],"layouts":[{"name":"Dia 04","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-74.11391851719993,"y":4.650772990543123},"scale":238459.1879730349,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Los puntos negros de Bogotá","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"5.176 siniestros con muertos en 10 años, 4 de cada 10 atropellos. El foco: Av. Boyacá con Primero de Mayo","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"Rectangle","x":184.5,"y":30.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":5,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":6,"name":"Rectangle","x":11.0,"y":218.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":7,"name":"Scale Bar","x":13.0,"y":220.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line"}}},{"id":8,"name":"Colorbar","x":10.0,"y":232.0,"w":58.0,"h":16.0,"visible":true,"kind":{"Colorbar":{"frame":1,"layer":"Densidad de siniestros","title":"Siniestros mortales por km²","orientation":"Horizontal","ticks":5,"tick_side":"End","reverse":false}}},{"id":9,"name":"Legend","x":10.0,"y":251.0,"w":58.0,"h":14.0,"visible":true,"kind":{"Legend":{"frame":1,"title":"Cada punto","all_classes":false,"hide_other":false,"exclude":["Densidad de siniestros"]}}},{"id":10,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":21.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: todo en RustGIS web (web.rustgis.app), con tres scripts.\n1 · Datos: los siniestros con muertos 2016–2025 del SIMUR en 3 consultas PBF de 2000, sin los\n     duplicados del servicio, sobre el mapa base azul de IDECA, con su estilo oficial.\n2 · Vista: Merge y Kernel Density (Quartic, radio 600 m, celdas de 50 m, EPSG:9377) en siniestros\n     por km², con rampa Inferno; bajo 5 por km² no se dibuja. Encima, cada siniestro.\n3 · Layout: armado por script. Los scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":11,"name":"Text","x":72.0,"y":255.0,"w":128.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Datos: Siniestros viales con muertos 2016–2025, Secretaría Distrital de Movilidad (SIMUR),\nconsultado el 2026-11-03. Se omiten los formularios \"AA\", copia de otro siniestro.\nMapa base: Mapa base azul, IDECA.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":12,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 4: Clusters · Hecho con RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":13},{"name":"Day 04","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-74.11391851719993,"y":4.650772990543123},"scale":238459.1879730349,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Bogotá's black spots","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"5,176 fatal crashes in 10 years, 4 in 10 hitting pedestrians. The worst spot: Av. Boyacá at Primero de Mayo","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"Rectangle","x":184.5,"y":30.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":5,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":6,"name":"Rectangle","x":11.0,"y":218.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[34,34,34,255],"width":1.0,"radius":1.0}}},{"id":7,"name":"Scale Bar","x":13.0,"y":220.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line"}}},{"id":8,"name":"Colorbar","x":10.0,"y":232.0,"w":58.0,"h":16.0,"visible":true,"kind":{"Colorbar":{"frame":1,"layer":"Densidad de siniestros","title":"Fatal crashes per km²","orientation":"Horizontal","ticks":5,"tick_side":"End","reverse":false}}},{"id":9,"name":"Legend","x":10.0,"y":251.0,"w":58.0,"h":14.0,"visible":true,"kind":{"Legend":{"frame":1,"title":"Each dot","all_classes":false,"hide_other":false,"exclude":["Densidad de siniestros"]}}},{"id":10,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":21.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts.\n1 · Data: SIMUR's fatal crashes 2016–2025 in 3 PBF queries of 2,000, without the service's\n     duplicates, on IDECA's blue basemap, with its official style.\n2 · View: Merge and Kernel Density (Quartic, 600 m radius, 50 m cells, EPSG:9377) in crashes\n     per km², Inferno ramp; under 5 per km² is not drawn. On top, each crash.\n3–4 · Layouts in Spanish and English, by script: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":11,"name":"Text","x":72.0,"y":255.0,"w":128.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Data: Road crashes with deaths 2016–2025, Secretaría Distrital de Movilidad (SIMUR),\naccessed 2026-11-03. \"AA\" forms are left out: they copy another crash.\nBasemap: Mapa base azul, IDECA.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":12,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 4: Clusters · Made with RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":13}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}