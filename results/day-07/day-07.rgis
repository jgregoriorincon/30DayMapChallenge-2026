":[0,0,0,166],"outline":[34,34,34,255],"width":0.0,"radius":1.0}}},{"id":18,"name":"Text","x":12.5,"y":113.5,"w":16.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"16:00","size":13.0,"color":[255,214,10,255],"bold":true}}},{"id":19,"name":"Rectangle","x":81.75,"y":113.0,"w":17.0,"h":7.5,"visible":true,"kind":{"Rectangle":{"fill":[0,0,0,166],"outline":[34,34,34,255],"width":0.0,"radius":1.0}}},{"id":20,"name":"Text","x":82.75,"y":113.5,"w":16.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"17:00","size":13.0,"color":[255,214,10,255],"bold":true}}},{"id":21,"name":"Rectangle","x":152.0,"y":113.0,"w":17.0,"h":7.5,"visible":true,"kind":{"Rectangle":{"fill":[0,0,0,166],"outline":[34,34,34,255],"width":0.0,"radius":1.0}}},{"id":22,"name":"Text","x":153.0,"y":113.5,"w":16.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"18:00","size":13.0,"color":[255,214,10,255],"bold":true}}},{"id":23,"name":"Rectangle","x":222.25,"y":113.0,"w":17.0,"h":7.5,"visible":true,"kind":{"Rectangle":{"fill":[0,0,0,166],"outline":[34,34,34,255],"width":0.0,"radius":1.0}}},{"id":24,"name":"Text","x":223.25,"y":113.5,"w":16.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"19:00","size":13.0,"color":[255,214,10,255],"bold":true}}},{"id":25,"name":"Text","x":10.0,"y":7.0,"w":277.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"An afternoon of clouds over Colombia","size":22.0,"color":[31,41,55,255],"bold":true}}},{"id":26,"name":"Text","x":10.0,"y":18.5,"w":277.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"5 November 2026, Colombian time. GOES-East looks at it every 10 minutes; here, one image per hour.\nFrom 17:00, the GeoColor product switches to its night view (the sun sets between 17:10 and 18:00, depending on the region).","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":27,"name":"Text","x":10.0,"y":190.0,"w":277.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts. 1 · Data: GOES-East GeoColor tiles from NASA GIBS, with the time in the address,\nand Colombia's boundary. 2 · View: one map per hour (Duplicate Map with its own image). 3–4 · Layouts in Spanish and English, by script: github.com/jgregoriorincon/30DayMapChallenge-2026","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":28,"name":"Text","x":10.0,"y":198.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Data: NOAA GOES-East ABI, GeoColor product (CIRA/NOAA), served by NASA GIBS (Worldview); accessed 2026-11-06. Boundary: geoBoundaries (CC0).","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":29,"name":"Text","x":10.0,"y":203.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 7: 10 minute map · Made with RustGIS · rustgis.app","size":7.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":30}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}