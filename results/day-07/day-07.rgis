5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Datos: NOAA GOES-East ABI, producto GeoColor (CIRA/NOAA), servido por NASA GIBS (Worldview); consultado el 2026-11-06. Límite: geoBoundaries (CC0).","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":29,"name":"Text","x":10.0,"y":203.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 7: 10 minute map · Hecho con RustGIS · rustgis.app","size":7.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":30},{"name":"Day 07","width":297.0,"height":210.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":30.0,"w":66.25,"h":78.0,"visible":true,"kind":{"MapFrame":{"map":"12:00","center":{"x":-72.93244009652538,"y":4.152438632327964},"scale":26255029.42210131,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Map Frame","x":80.25,"y":30.0,"w":66.25,"h":78.0,"visible":true,"kind":{"MapFrame":{"map":"13:00","center":{"x":-72.93244009652538,"y":4.152438632327964},"scale":26255029.42210131,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Map Frame","x":150.5,"y":30.0,"w":66.25,"h":78.0,"visible":true,"kind":{"MapFrame":{"map":"14:00","center":{"x":-72.93244009652538,"y":4.152438632327964},"scale":26255029.42210131,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":4,"name":"Map Frame","x":220.75,"y":30.0,"w":66.25,"h":78.0,"visible":true,"kind":{"MapFrame":{"map":"15:00","center":{"x":-72.93244009652538,"y":4.152438632327964},"scale":26255029.42210131,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":5,"name":"Map Frame","x":10.0,"y":112.0,"w":66.25,"h":78.0,"visible":true,"kind":{"MapFrame":{"map":"16:00","center":{"x":-72.93244009652538,"y":4.152438632327964},"scale":26255029.42210131,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":6,"name":"Map Frame","x":80.25,"y":112.0,"w":66.25,"h":78.0,"visible":true,"kind":{"MapFrame":{"map":"17:00","center":{"x":-72.93244009652538,"y":4.15243863232796