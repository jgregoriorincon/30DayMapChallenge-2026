ry_type":"None","fields":[{"name":"join_count","ty":"Integer","alias":null},{"name":"FREQUENCY","ty":"Integer","alias":null},{"name":"SUM_personas","ty":"Double","alias":null}],"features":[{"id":1,"geometry":null,"attrs":[{"Int":0},{"Int":1142},{"Float":189842.0}]},{"id":2,"geometry":null,"attrs":[{"Int":1},{"Int":88},{"Float":911390.0}]}],"source":null}],"next_table_id":2,"gp_history":[{"tool":"Simplify","id":"simplify","params":{"input":"Zonas urbanas","output":"Perímetro urbano · Urban perimeter","tolerance":0.005},"at":1794107043,"ok":true,"messages":["Simplify: 22365 → 2445 vertices"],"millis":13,"outputs":["Perímetro urbano · Urban perimeter"]},{"tool":"Spatial Join","id":"spatialJoin","params":{"join":"Perímetro urbano · Urban perimeter","keepAll":"Keep all","match":"Have their center in","operation":"Join one to one","output":"Grado de urbanización · Degree of urbanisation","prefix":"join_","target":"Grilla 1 km","units":"Kilometers"},"at":1794107043,"ok":true,"messages":["Spatial Join: 1230 features joined (88 matches)"],"millis":9,"outputs":["Grado de urbanización · Degree of urbanisation"]},{"tool":"Summary Statistics","id":"summaryStatistics","params":{"case":"join_count","input":"Grado de urbanización · Degree of urbanisation","separator":", ","statistics":[{"field":"personas","statistic":"SUM"}]},"at":1794107043,"ok":true,"messages":["Summary Statistics: 2 rows"],"millis":2,"outputs":[]}],"layouts":[{"name":"Dia 09","width":297.0,"height":210.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":32.0,"w":190.0,"h":150.0,"visible":true,"kind":{"MapFrame":{"map":"Urbano-rural","center":{"x":-73.226515501,"y":7.022779542454203},"scale":405671.5914643529,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":7.0,"w":277.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"¿Dónde termina la ciudad?","size":22.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":18.5,"w":277.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Área metropolitana de Bucaramanga, Colombia: el grado de urbanización del censo en celdas de 1 km y, en negro, el perímetro urbano legal.\n1 de cada 6 habitantes (190 mil de 1,1 millones) vive en celdas cuyo centro queda fuera del perímetro urbano.","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"Rectangle","x":184.5,"y":34.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":5,"name":"North Arrow","x":186.0,"y":35.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":6,"name":"Rectangle","x":11.0,"y":171.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":7,"name":"Scale Bar","x":13.0,"y":173.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[34,34,34,255],"fill":[255,255,255,255]}}},{"id":8,"name":"Text","x":208.0,"y":32.0,"w":79.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Grado de urbanización y personas","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":9,"name":"Legend","x":208.0,"y":37.0,"w":79.0,"h":45.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false}}},{"id":10,"name":"Text","x":208.0,"y":86.0,"w":79.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Fuera del perímetro","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":11,"name":"Text","x":208.0,"y":92.0,"w":79.0,"h":22.0,"visible":true,"kind":{"Text":{"text":"Girón: 61 mil personas. Bucaramanga: 54 mil.\nPiedecuesta: 52 mil. Floridablanca: 23 mil.\nDe los 190 mil, 116 mil viven en celdas\nque el censo ya clasifica como urbanas\no suburbanas (clases 30, 23 y 21).","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":12,"name":"Text","x":208.0,"y":120.0,"w":79.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Al leerlo","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":13,"name":"Text","x":208.0,"y":126.0,"w":79.0,"h":34.0,"visible":true,"kind":{"Text":{"text":"El grado de urbanización (método de la ONU,\n2020) clasifica cada celda por su densidad y\nla de sus vecinas: centro urbano es un grupo\nde celdas con 1500 habitantes por km² o más\nque suma al menos 50 000.\nCada celda cuenta entera del lado donde cae\nsu centro: una celda partida por el perímetro\nno se reparte.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":14,"name":"Text","x":10.0,"y":186.0,"w":277.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: todo en RustGIS web (web.rustgis.app), con cuatro scripts. 1 · Datos: la grilla de 1 km del DANE y los perímetros urbanos del AMB, consultados en sus servidores.\n2 · Vista: Simplify, Spatial Join (cada celda por su centro) y Summary Statistics (personas dentro y fuera). 3–4 · Layouts. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":15,"name":"Text","x":10.0,"y":194.0,"w":277.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Datos: DANE, Grilla estadística de 1 km con el grado de urbanización (Censo Nacional de Población y Vivienda 2018); Área Metropolitana de Bucaramanga, mapa base vectorial (zonas urbanas);\nconsultados el 2026-11-07. Colores: GHSL (Comisión Europea). Mapa base: OpenFreeMap Positron, © OpenMapTiles, datos de © colaboradores de OpenStreetMap (ODbL). Este mapa y su proyecto: CC BY 4.0.","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":16,"name":"Text","x":10.0,"y":203.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 9: Urban-rural · Hecho con RustGIS · rustgis.app","size":7.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":17},{"name":"Day 09","width":297.0,"height":210.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":32.0,"w":190.0,"h":150.0,"visible":true,"kind":{"MapFrame":{"map":"Urbano-rural","center":{"x":-73.226515501,"y":7.022779542454203},"scale":405671.5914643529,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":7.0,"w":277.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Where does the city end?","size":22.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":18.5,"w":277.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Bucaramanga metropolitan area, Colombia: the census degree of urbanisation in 1 km cells and, in black, the legal urban perimeter.\n1 in 6 residents (190,000 of 1.1 million) lives in cells whose centre lies outside the urban perimeter.","size":10.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"Rectangle","x":184.5,"y":34.0,"w":14.0,"h":17.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":5,"name":"North Arrow","x":186.0,"y":35.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":6,"name":"Rectangle","x":11.0,"y":171.5,"w":32.0,"h":9.0,"visible":true,"kind":{"Rectangle":{"fill":[255,255,255,204],"outline":[255,255,255,204],"width":1.0,"radius":1.0}}},{"id":7,"name":"Scale Bar","x":13.0,"y":173.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[34,34,34,255],"fill":[255,255,255,255]}}},{"id":8,"name":"Text","x":208.0,"y":32.0,"w":79.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Degree of urbanisation and people","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":9,"name":"Legend","x":208.0,"y":37.0,"w":79.0,"h":45.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false}}},{"id":10,"name":"Text","x":208.0,"y":86.0,"w":79.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Outside the perimeter","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":11,"name":"Text","x":208.0,"y":92.0,"w":79.0,"h":22.0,"visible":true,"kind":{"Text":{"text":"Girón: 61,000 people. Bucaramanga: 54,000.\nPiedecuesta: 52,000. Floridablanca: 23,000.\nOf the 190,000, 116,000 live in cells the\ncensus already classes as urban or\nsuburban (classes 30, 23 and 21).","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":12,"name":"Text","x":208.0,"y":120.0,"w":79.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Reading it","size":9.0,"color":[31,41,55,255],"bold":true}}},{"id":13,"name":"Text","x":208.0,"y":126.0,"w":79.0,"h":34.0,"visible":true,"kind":{"Text":{"text":"The degree of urbanisation (UN method,\n2020) classes each cell by its density and\nits neighbours': an urban centre is a group\nof cells with 1,500 inhabitants per km² or\nmore that adds up to at least 50,000.\nEach cell counts whole on the side where its\ncentre falls: a cell split by the perimeter\nisn't shared out.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":14,"name":"Text","x":10.0,"y":186.0,"w":277.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts. 1 · Data: DANE's 1 km grid and the AMB urban perimeters, queried from their servers.\n2 · View: Simplify, Spatial Join (each cell by its centre) and Summary Statistics (people inside and outside). 3–4 · Layouts. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":15,"name":"Text","x":10.0,"y":194.0,"w":277.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Data: DANE (national statistics office), 1 km statistical grid with the degree of urbanisation (2018 National Population and Housing Census); Bucaramanga Metropolitan Area (AMB), vector basemap (urban zones);\naccessed 2026-11-07. Colours: GHSL (European Commission). Basemap: OpenFreeMap Positron, © OpenMapTiles, data © OpenStreetMap contributors (ODbL). This map and its project: CC BY 4.0.","size":6.5,"color":[31,41,55,255],"bold":false}}},{"id":16,"name":"Text","x":10.0,"y":203.5,"w":277.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 9: Urban-rural · Made with RustGIS · rustgis.app","size":7.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":17}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}