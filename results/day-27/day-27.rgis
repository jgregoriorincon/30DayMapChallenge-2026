}}},{"id":2,"name":"Map Frame","x":0.0,"y":0.0,"w":355.6,"h":215.9,"visible":true,"kind":{"MapFrame":{"map":"Tablero","center":{"x":-75.0,"y":5.2},"scale":6200000.0,"shape":"Rectangle","grid":null,"extent_of":null,"bearing":12.0,"pitch":61.0}}},{"id":3,"name":"North Arrow","x":333.6,"y":182.0,"w":10.0,"h":14.0,"visible":true,"kind":{"NorthArrow":{"frame":2,"style":"Classic","fill":[255,255,255,255],"outline":[34,34,34,255]}}},{"id":4,"name":"Rectangle","x":233.6,"y":8.0,"w":114.0,"h":73.0,"visible":true,"kind":{"Rectangle":{"fill":[11,15,26,192],"outline":[11,15,26,0],"width":0.0,"radius":2.0}}},{"id":5,"name":"Text","x":237.6,"y":11.0,"w":106.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"#30DAYMAPCHALLENGE · DÍA 27 · NEW TOOL","size":6.5,"color":[243,232,200,255],"bold":false,"letter_spacing":2.0}}},{"id":6,"name":"Text","x":237.6,"y":15.0,"w":106.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"Colombia como Catan","size":19.0,"color":[255,255,255,255],"bold":true}}},{"id":7,"name":"Text","x":237.6,"y":24.5,"w":106.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"87 de las 171 fichas de tierra son selva. Le siguen la montaña,\nla sabana y el humedal. Desierto hay solo 4 fichas, todas en la Guajira.","size":8.0,"color":[221,230,216,255],"bold":false}}},{"id":8,"name":"Picture","x":242.1,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":9,"name":"Text","x":237.1,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Selva","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":10,"name":"Picture","x":259.6,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":11,"name":"Text","x":254.6,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Montaña","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":12,"name":"Picture","x":277.1,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":13,"name":"Text","x":272.1,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Sabana","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":14,"name":"Picture","x":294.6,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":15,"name":"Text","x":289.6,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Humedal","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":16,"name":"Picture","x":312.1,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":17,"name":"Text","x":307.1,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Desierto","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":18,"name":"Picture","x":329.6,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":19,"name":"Text","x":324.6,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Insular","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":20,"name":"Text","x":237.6,"y":48.0,"w":106.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Cada ficha es un hexágono de Generate Tessellation de unos 8300 km²\n(57 km de lado), puesto donde lo pone la malla: ninguno se movió para\nconservar la silueta. Cada ficha lleva el ecosistema que cubre\nla mayor parte de su superficie.","size":7.5,"color":[232,236,241,255],"bold":false}}},{"id":21,"name":"Text","x":237.6,"y":63.0,"w":106.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Datos: Mapa de Ecosistemas Continentales, Costeros y Marinos\n2024 (IDEAM); contorno: MGN 2018 (DANE); ZEE: Marine Regions\n(VLIZ). Imagen: Esri, Maxar, Earthstar Geographics.\nInspiración:«Colombiatán», Rodolfo Franco (2023).","size":7.5,"color":[169,180,194,255],"bold":false}}},{"id":22,"name":"Scale Bar","x":282.0,"y":199.0,"w":46.0,"h":7.0,"visible":true,"kind":{"ScaleBar":{"frame":2,"units":"Kilometers","divisions":2,"style":"Alternating","color":[255,255,255,255],"fill":[11,15,26,255]}}},{"id":23,"name":"Text","x":282.0,"y":207.0,"w":46.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Escala en el centro del mapa","size":7.5,"color":[232,236,241,255],"bold":false}}},{"id":24,"name":"Text","x":8.0,"y":206.0,"w":200.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Día 27: New tool · Hecho con RustGIS · rustgis.app","size":7.5,"color":[232,236,241,255],"bold":false}}}],"series":null,"next_id":25},{"name":"Day 27","width":355.6,"height":215.9,"elements":[{"id":1,"name":"Rectangle","x":0.0,"y":0.0,"w":355.6,"h":215.9,"visible":true,"kind":{"Rectangle":{"fill":[11,15,26,255],"outline":[11,15,26,0],"width":0.0}}},{"id":2,"name":"Map Frame","x":0.0,"y":0.0,"w":355.6,"h":215.9,"visible":true,"kind":{"MapFrame":{"map":"Tablero","center":{"x":-75.0,"y":5.2},"scale":6200000.0,"shape":"Rectangle","grid":null,"extent_of":null,"bearing":12.0,"pitch":61.0}}},{"id":3,"name":"North Arrow","x":333.6,"y":182.0,"w":10.0,"h":14.0,"visible":true,"kind":{"NorthArrow":{"frame":2,"style":"Classic","fill":[255,255,255,255],"outline":[34,34,34,255]}}},{"id":4,"name":"Rectangle","x":233.6,"y":8.0,"w":114.0,"h":73.0,"visible":true,"kind":{"Rectangle":{"fill":[11,15,26,192],"outline":[11,15,26,0],"width":0.0,"radius":2.0}}},{"id":5,"name":"Text","x":237.6,"y":11.0,"w":106.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"#30DAYMAPCHALLENGE · DAY 27 · NEW TOOL","size":6.5,"color":[243,232,200,255],"bold":false,"letter_spacing":2.0}}},{"id":6,"name":"Text","x":237.6,"y":15.0,"w":106.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"Colombia as Catan","size":19.0,"color":[255,255,255,255],"bold":true}}},{"id":7,"name":"Text","x":237.6,"y":24.5,"w":106.0,"h":8.0,"visible":true,"kind":{"Text":{"text":"87 of the 171 land tiles are rainforest, followed by mountains,\nsavanna and wetlands. There are only 4 desert tiles, all in La Guajira.","size":8.0,"color":[221,230,216,255],"bold":false}}},{"id":8,"name":"Picture","x":242.1,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":9,"name":"Text","x":237.1,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Rainforest","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":10,"name":"Picture","x":259.6,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":11,"name":"Text","x":254.6,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Mountains","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":12,"name":"Picture","x":277.1,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":13,"name":"Text","x":272.1,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Savanna","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":14,"name":"Picture","x":294.6,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":15,"name":"Text","x":289.6,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Wetland","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":16,"name":"Picture","x":312.1,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":17,"name":"Text","x":307.1,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Desert","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":18,"name":"Picture","x":329.6,"y":34.0,"w":7.0,"h":7.0,"visible":true,"kind":{"Picture":{"image":""}}},{"id":19,"name":"Text","x":324.6,"y":41.5,"w":17.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Island","size":7.5,"color":[255,255,255,255],"bold":false,"align":"Center"}}},{"id":20,"name":"Text","x":237.6,"y":48.0,"w":106.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Each tile is a Generate Tessellation hexagon of about 8,300 km²\n(57 km per side), placed where the grid puts it: none was moved to\nkeep the outline. Each tile shows the ecosystem that covers\nmost of its area.","size":7.5,"color":[232,236,241,255],"bold":false}}},{"id":21,"name":"Text","x":237.6,"y":63.0,"w":106.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Data: Mapa de Ecosistemas Continentales, Costeros y Marinos\n2024 (IDEAM); outline: MGN 2018 (DANE); EEZ: Marine Regions\n(VLIZ). Imagery: Esri, Maxar, Earthstar Geographics.\nInspired by «Colombiatán», Rodolfo Franco (2023).","size":7.5,"color":[169,180,194,255],"bold":false}}},{"id":22,"name":"Scale Bar","x":282.0,"y":199.0,"w":46.0,"h":7.0,"visible":true,"kind":{"ScaleBar":{"frame":2,"units":"Kilometers","divisions":2,"style":"Alternating","color":[255,255,255,255],"fill":[11,15,26,255]}}},{"id":23,"name":"Text","x":282.0,"y":207.0,"w":46.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Scale at the map centre","size":7.5,"color":[232,236,241,255],"bold":false}}},{"id":24,"name":"Text","x":8.0,"y":206.0,"w":200.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Day 27: New tool · Made with RustGIS · rustgis.app","size":7.5,"color":[232,236,241,255],"bold":false}}}],"series":null,"next_id":25}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}