0,"pitch":0.0},"bookmarks":[],"graticule":true,"projection":"WebMercator","popup_mode":"Topmost","label_display":{"paused":false,"locked":false,"show_unplaced":false},"editing":{"relationships":[],"snapping":{"enabled":false,"tolerance_px":10.0,"vertex":true,"edge":true,"end":true},"topology":[],"settings":{"enabled":true,"show_vertices":true,"elevation":"None","ground_to_grid":null}},"swipe":null,"view":{"effects":{"stars":true,"sun_time":null,"weather":"None","vignette":false,"edges":false,"tilt_shift":false,"grain":false,"brightness":0.0,"contrast":0.0,"saturation":0.0,"sepia":0.0},"wireframe":false,"clip_distance":null,"terrain":null},"animation":[],"next_layer_id":4}],"active_map":0,"tables":[],"next_table_id":1,"gp_history":[{"tool":"Merge","id":"merge","params":{"attributes":true,"inputs":"Arboles 1;Arboles 2","output":"Gigantes verdes de Bogotá"},"at":1793706608,"ok":true,"messages":["Merge: 3364 features from 2 layers"],"millis":1,"outputs":["Gigantes verdes de Bogotá"]}],"layouts":[{"name":"Dia 01","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-74.117975514,"y":4.649363401623172},"scale":198306.87502667954,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Los gigantes de Bogotá","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"3.364 árboles de más de 30 m. Los más altos, en los cerros de Santa Fe: el mayor mide 51 m","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":5,"name":"Scale Bar","x":13.0,"y":220.0,"w":50.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line"}}},{"id":6,"name":"Legend","x":10.0,"y":232.0,"w":58.0,"h":40.0,"visible":true,"kind":{"Legend":{"frame":1,"title":"Altura de los árboles","all_classes":false,"hide_other":false}}},{"id":7,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":22.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: todo en RustGIS web (web.rustgis.app), con tres scripts.\n1 · Datos: el Censo de Arbolado Urbano en 2 consultas PBF de hasta 2000 árboles (más de 30 m)\n     y el Mapa Base Bogotá de IDECA como teselas vectoriales, con su estilo oficial.\n2 · Vista: Merge de las 2 consultas; Graduated Colors por Altura_Total (cortes en 35, 40 y 45 m)\n     y tamaño por expresión: (Altura_Total − 20) / 2.\n3 · Layout: armado por script. Los scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":8,"name":"Text","x":72.0,"y":257.0,"w":128.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"Datos: Censo de Arbolado Urbano, Jardín Botánico de Bogotá / IDECA (CC BY 4.0),\nconsultado el 2026-11-03. Mapa base: Mapa Base Bogotá, IDECA.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":9,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 1: Points · Hecho con RustGIS","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":10},{"name":"Day 01","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-74.117975514,"y":4.649363401623172},"scale":198306.87502667954,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Bogotá's giants","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"3,364 trees over 30 m tall. The tallest grow on the hills of Santa Fe: the highest reaches 51 m","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":5,"name":"Scale Bar","x":13.0,"y":220.0,"w":50.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line"}}},{"id":6,"name":"Legend","x":10.0,"y":232.0,"w":58.0,"h":40.0,"visible":true,"kind":{"Legend":{"frame":1,"title":"Tree height","all_classes":false,"hide_other":false}}},{"id":7,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":22.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts.\n1 · Data: the Urban Tree Census in 2 PBF queries of up to 2,000 trees (over 30 m)\n     and IDECA's Mapa Base Bogotá as vector tiles, with its official style.\n2 · View: Merge of the 2 queries; Graduated Colors by Altura_Total (breaks at 35, 40, 45 m)\n     and size by expression: (Altura_Total − 20) / 2.\n3–4 · Layouts in Spanish and English, by script: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":8,"name":"Text","x":72.0,"y":257.0,"w":128.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"Data: Urban Tree Census, Jardín Botánico de Bogotá / IDECA (CC BY 4.0),\naccessed 2026-11-03. Basemap: Mapa Base Bogotá, IDECA.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":9,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 1: Points · Made with RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":10}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}