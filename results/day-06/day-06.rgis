xt_table_id":1,"gp_history":[],"layouts":[{"name":"Day 06","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-75.54478358031308,"y":10.42469869417783},"scale":23207.114431666385,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Cartagena de Indias, as Herrera drew it","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Colombia, 18th century: its wall tips (bastions) land typically about 16 m from where they stand today","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":5,"name":"Scale Bar","x":13.0,"y":220.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[34,34,34,255],"fill":[255,255,255,255]}}},{"id":6,"name":"Text","x":10.0,"y":232.0,"w":58.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"In red, today","size":13.0,"color":[31,41,55,255],"bold":false}}},{"id":7,"name":"Legend","x":10.0,"y":240.0,"w":58.0,"h":12.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false,"exclude":["Plano de Herrera"]}}},{"id":8,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":21.0,"visible":true,"kind":{"Text":{"text":"How it was made: all in RustGIS web (web.rustgis.app), with four scripts.\n1 · Data: Herrera's plan from Wikimedia Commons, as a picture with no coordinates, and\n     the tips of 9 bastions and the San Felipe Castle taken from OpenStreetMap.\n2 · View: Control Point Fit and Georeference with those 10 points (affine transform). The\n     plan's north ends up at the lower left, as Herrera drew it.\n3–4 · Layouts in Spanish and English, by script: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":9,"name":"Text","x":72.0,"y":255.0,"w":128.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Data: Plano de Cartagena de las Indias, Juan de Herrera y Sotomayor (18th century) —\nBibliothèque nationale de France, Gallica (public domain), via Wikimedia Commons.\nBastions and basemap: © OpenStreetMap contributors (ODbL), accessed 2026-11-05.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":10,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 6: Vintage · Made with RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":11},{"name":"Dia 06","width":210.0,"height":297.0,"elements":[{"id":1,"name":"Map Frame","x":10.0,"y":28.0,"w":190.0,"h":200.0,"visible":true,"kind":{"MapFrame":{"map":"Map","center":{"x":-75.54478358031308,"y":10.42469869417783},"scale":23207.114431666385,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":2,"name":"Text","x":10.0,"y":8.0,"w":190.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Cartagena de Indias, según Herrera","size":24.0,"color":[31,41,55,255],"bold":true}}},{"id":3,"name":"Text","x":10.0,"y":19.0,"w":190.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Colombia, siglo XVIII: las puntas de su muralla (baluartes) caen a unos 16 m de donde siguen hoy (error típico)","size":11.0,"color":[31,41,55,255],"bold":false}}},{"id":4,"name":"North Arrow","x":186.0,"y":31.0,"w":11.0,"h":15.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Compass","fill":[34,34,34,255],"outline":[34,34,34,255]}}},{"id":5,"name":"Scale Bar","x":13.0,"y":220.0,"w":30.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[34,34,34,255],"fill":[255,255,255,255]}}},{"id":6,"name":"Text","x":10.0,"y":232.0,"w":58.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"En rojo, hoy","size":13.0,"color":[31,41,55,255],"bold":false}}},{"id":7,"name":"Legend","x":10.0,"y":240.0,"w":58.0,"h":12.0,"visible":true,"kind":{"Legend":{"frame":1,"title":" ","all_classes":false,"hide_other":false,"exclude":["Plano de Herrera"]}}},{"id":8,"name":"Text","x":72.0,"y":232.0,"w":128.0,"h":21.0,"visible":true,"kind":{"Text":{"text":"Cómo se hizo: todo en RustGIS web (web.rustgis.app), con cuatro scripts.\n1 · Datos: el plano de Herrera desde Wikimedia Commons, como imagen sin coordenadas, y\n     la punta de 9 baluartes y el Castillo de San Felipe tomados de OpenStreetMap.\n2 · Vista: Control Point Fit y Georeference con esos 10 puntos (transformación afín). El\n     norte del plano queda abajo a la izquierda, como lo dibujó Herrera.\n3–4 · Layouts en español e inglés. Los scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":9,"name":"Text","x":72.0,"y":255.0,"w":128.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"Datos: Plano de Cartagena de las Indias, Juan de Herrera y Sotomayor (siglo XVIII) —\nBibliothèque nationale de France, Gallica (dominio público), vía Wikimedia Commons.\nBaluartes y mapa base: © colaboradores de OpenStreetMap (ODbL), consultado el 2026-11-05.","size":7.0,"color":[31,41,55,255],"bold":false}}},{"id":10,"name":"Text","x":10.0,"y":284.0,"w":190.0,"h":6.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 6: Vintage · Hecho con RustGIS · rustgis.app","size":8.0,"color":[31,41,55,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":11}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}