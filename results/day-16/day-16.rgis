ind":{"Text":{"text":"Riesgo por remoción alto no mitigable","size":6.3,"color":[31,35,40,255],"bold":false}}},{"id":56,"name":"Rectangle","x":126.6,"y":200.8,"w":3.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[140,106,74,20],"outline":[140,106,74,255],"width":0.3}}},{"id":57,"name":"Line","x":126.6,"y":200.8,"w":3.2,"h":3.0,"visible":true,"kind":{"Line":{"color":[140,106,74,166],"width":0.5,"dir":"Rising","head":"None"}}},{"id":58,"name":"Text","x":132.0,"y":200.6,"w":68.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"Ladera empinada","size":6.3,"color":[31,35,40,255],"bold":false}}},{"id":59,"name":"North Arrow","x":106.0,"y":230.0,"w":4.0,"h":6.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[74,88,102,255],"outline":[74,88,102,255]}}},{"id":60,"name":"Scale Bar","x":16.0,"y":238.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[74,88,102,255],"fill":[255,255,255,255]}}},{"id":61,"name":"Text","x":12.0,"y":251.0,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"POR QUÉ AHÍ","size":6.5,"color":[139,26,18,255],"bold":true,"letter_spacing":1.2}}},{"id":62,"name":"Text","x":12.0,"y":255.5,"w":92.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"Los barrios crecieron hasta el borde de la loma. Donde la\nladera es empinada (rayado, curvas apretadas), el Decreto\n0893 de 2024 marca un riesgo que ninguna obra estabiliza. Cada punto\nes un predio informal, no prueba una casa a punto de caer.","size":7.0,"color":[74,88,102,255],"bold":false}}},{"id":63,"name":"Text","x":108.0,"y":251.0,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"QUÉ DICE LA NORMA","size":6.5,"color":[139,26,18,255],"bold":true,"letter_spacing":1.2}}},{"id":64,"name":"Text","x":108.0,"y":255.5,"w":92.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"El Decreto 0893 de 2024 adoptó el estudio detallado de riesgo\n(1:2 000) de las localidades Suroccidente y Metropolitana.\nLa Ley 388 de 1997 manda fijar las zonas no urbanizables por\nriesgo.","size":7.0,"color":[74,88,102,255],"bold":false}}},{"id":65,"name":"Line","x":12.0,"y":274.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[217,211,199,255],"width":0.4,"dir":"Horizontal","head":"None"}}},{"id":66,"name":"Text","x":12.0,"y":276.0,"w":186.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Datos: Alcaldía de Barranquilla (CC BY-SA 4.0), consultados el 2026-11-15. Predios informales: Gerencia de Gestión Catastral, Concentración de informalidad (2026-11-03).\nRiesgo: estudio detallado de riesgo por movimientos en masa de la ladera occidental (CI Ambiental, convenio AFD), adoptado por el Decreto 0893 de 2024; nivel alto no mitigable.\nRelieve y barrios: Secretaría de Planeación. Mapa base: Mi Ciudad. Cómo se hizo: todo en RustGIS web (web.rustgis.app), con cuatro scripts.\nLos predios se cruzan con la zona de riesgo (Spatial Join) y los barrios con esos predios. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.0,"color":[107,114,128,255],"bold":false}}},{"id":67,"name":"Text","x":12.0,"y":291.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · Pamela Mayorga Ramos · CC BY-SA 4.0 · #30DayMapChallenge 2026 · Día 16: Collaborative map · Hecho con RustGIS · rustgis.app","size":6.5,"color":[139,26,18,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":68},{"name":"Day 16","width":210.0,"height":297.0,"elements":[{"id":2,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[245,242,237,255],"outline":[245,242,237,255],"width":0.0}}},{"id":1,"name":"Map Frame","x":12.0,"y":32.0,"w":110.0,"h":215.0,"visible":true,"kind":{"MapFrame":{"map":"Barranquilla","center":{"x":-74.82,"y":10.956},"scale":33000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":12.0,"y":6.0,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 16 · COLLABORATIVE MAP · BARRANQUILLA","size":7.0,"color":[139,26,18,255],"bold":false,"letter_spacing":2.0}}},{"id":4,"name":"Text","x":12.0,"y":11.0,"w":186.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Where no works can stop the risk","size":22.0,"color":[31,35,40,255],"bold":true}}},{"id":5,"name":"Text","x":12.0,"y":22.5,"w":186.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Informal plots on the hillside of south-west Barranquilla, in zones of high, non-mitigable landslide risk","size":8.5,"color":[74,88,102,255],"bold":false}}},{"id":6,"name":"Text","x":126.0,"y":36.0,"w":74.0,"h":15.0,"visible":true,"kind":{"Text":{"text":"2,121","size":36.0,"color":[178,24,43,255],"bold":true}}},{"id":7,"name":"Text","x":126.0,"y":52.0,"w":74.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"informal plots sit where the risk\nis high and cannot be mitigated.\nThere the way out is not a title:\nit is resettlement.","size":8.0,"color":[31,35,40,255],"bold":false}}},{"id":8,"name":"Text","x":126.0,"y":74.0,"w":74.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"PLOTS IN NON-MITIGABLE RISK,\nBY NEIGHBOURHOOD","size":6.5,"color":[139,26,18,255],"bold":true,"letter_spacing":1.2}}},{"id":9,"name":"Text","x":126.0,"y":83.6,"w":37.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"Carlos Meisel","size":6.3,"color":[31,35,40,255],"bold":false,"align":"Right"}}},{"id":10,"name":"Rectangle","x":164.5,"y":84.0,"w":30.0,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[178,24,43,230],"outline":[178,24,43,0],"width":0.0}}},{"id":11,"name":"Text","x":195.7,"y":83.6,"w":12.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"244","size":6.0,"color":[31,35,40,255],"bold":false}}},{"id":12,"name":"Text","x":126.0,"y":90.19999999999999,"w":37.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"El Bosque","size":6.3,"color":[31,35,40,255],"bold":false,"align":"Right"}}},{"id":13,"name":"Rectangle","x":164.5,"y":90.6,"w":29.02,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[178,24,43,230],"outline":[178,24,43,