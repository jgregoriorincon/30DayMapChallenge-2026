ente (1,569).","size":6.0,"color":[107,114,128,255],"bold":false}}},{"id":49,"name":"Text","x":126.0,"y":180.8,"w":74.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"LEGEND","size":6.5,"color":[139,26,18,255],"bold":true,"letter_spacing":1.2}}},{"id":50,"name":"Circle","x":127.0,"y":186.1,"w":2.4,"h":2.4,"visible":true,"kind":{"Ellipse":{"fill":[178,24,43,230],"outline":[255,255,255,0],"width":0.0}}},{"id":51,"name":"Text","x":132.0,"y":185.6,"w":68.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"Informal plot in non-mitigable risk","size":6.3,"color":[31,35,40,255],"bold":false}}},{"id":52,"name":"Circle","x":127.0,"y":191.1,"w":2.4,"h":2.4,"visible":true,"kind":{"Ellipse":{"fill":[91,107,140,204],"outline":[255,255,255,0],"width":0.0}}},{"id":53,"name":"Text","x":132.0,"y":190.6,"w":68.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"Informal plot outside that zone","size":6.3,"color":[31,35,40,255],"bold":false}}},{"id":54,"name":"Rectangle","x":126.6,"y":195.8,"w":3.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[215,48,31,26],"outline":[198,42,30,255],"width":0.6}}},{"id":55,"name":"Text","x":132.0,"y":195.6,"w":68.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"High non-mitigable landslide risk","size":6.3,"color":[31,35,40,255],"bold":false}}},{"id":56,"name":"Rectangle","x":126.6,"y":200.8,"w":3.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[140,106,74,20],"outline":[140,106,74,255],"width":0.3}}},{"id":57,"name":"Line","x":126.6,"y":200.8,"w":3.2,"h":3.0,"visible":true,"kind":{"Line":{"color":[140,106,74,166],"width":0.5,"dir":"Rising","head":"None"}}},{"id":58,"name":"Text","x":132.0,"y":200.6,"w":68.0,"h":3.2,"visible":true,"kind":{"Text":{"text":"Steep hillside","size":6.3,"color":[31,35,40,255],"bold":false}}},{"id":59,"name":"North Arrow","x":106.0,"y":230.0,"w":4.0,"h":6.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[74,88,102,255],"outline":[74,88,102,255]}}},{"id":60,"name":"Scale Bar","x":16.0,"y":238.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[74,88,102,255],"fill":[255,255,255,255]}}},{"id":61,"name":"Text","x":12.0,"y":251.0,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"WHY THERE","size":6.5,"color":[139,26,18,255],"bold":true,"letter_spacing":1.2}}},{"id":62,"name":"Text","x":12.0,"y":255.5,"w":92.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"The neighbourhoods grew up to the edge of the hill. Where the\nslope is steep (hatched, tight contours), Decree 0893 of 2024\nmarks a risk no works can stabilise. Each dot is an informal plot;\nit does not prove a house is about to fall.","size":7.0,"color":[74,88,102,255],"bold":false}}},{"id":63,"name":"Text","x":108.0,"y":251.0,"w":90.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"WHAT THE RULES SAY","size":6.5,"color":[139,26,18,255],"bold":true,"letter_spacing":1.2}}},{"id":64,"name":"Text","x":108.0,"y":255.5,"w":92.0,"h":16.0,"visible":true,"kind":{"Text":{"text":"Decree 0893 of 2024 adopted the detailed risk study (1:2,000)\nof the Suroccidente and Metropolitana districts. Law 388 of\n1997 requires zones unfit for building due to risk to be set.\n","size":7.0,"color":[74,88,102,255],"bold":false}}},{"id":65,"name":"Line","x":12.0,"y":274.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[217,211,199,255],"width":0.4,"dir":"Horizontal","head":"None"}}},{"id":66,"name":"Text","x":12.0,"y":276.0,"w":186.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Data: City of Barranquilla (CC BY-SA 4.0), retrieved 2026-11-15. Informal plots: Cadastral Management Office, Concentración de informalidad (2026-11-03).\nRisk: detailed landslide risk study of the western hillside (CI Ambiental, AFD agreement), adopted by Decree 0893 of 2024; high, non-mitigable level.\nRelief and neighbourhoods: Planning Office. Basemap: Mi Ciudad. How it was made: all in RustGIS web (web.rustgis.app), with four scripts.\nPlots are crossed with the risk zone (Spatial Join), and neighbourhoods with those plots. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.0,"color":[107,114,128,255],"bold":false}}},{"id":67,"name":"Text","x":12.0,"y":291.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · Pamela Mayorga Ramos · CC BY-SA 4.0 · #30DayMapChallenge 2026 · Day 16: Collaborative map · Made with RustGIS · rustgis.app","size":6.5,"color":[139,26,18,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":68}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}