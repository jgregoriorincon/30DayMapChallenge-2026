ovember.","size":6.0,"color":[138,151,171,255],"bold":false}}},{"id":76,"name":"Line","x":12.0,"y":278.5,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[42,58,82,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":77,"name":"Text","x":12.0,"y":280.0,"w":186.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Data: UPME (Colombia's Mining and Energy Planning Unit) Geoportal, electricity layers: power plants (with XM data) and built\ntransmission lines, accessed 2026-11-11; UPME declares no licence and presents them as indicative and approximate. Departments:\nDANE, MGN 2025. Basemap: RustGIS Midnight. How it was made: all in RustGIS web (web.rustgis.app), with four scripts: PBF data,\nUnique Values, size by expression (square root of the MW) and layouts. Scripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.5,"color":[138,151,171,255],"bold":false}}},{"id":78,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 12: Power · Made with RustGIS · rustgis.app","size":6.5,"color":[255,210,63,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":79}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}