0\ntodavía no es 1:1","size":8.0,"color":[255,210,63,255],"bold":false}}},{"id":11,"name":"Text","x":14.0,"y":301.0,"w":120.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"EL MAPA DEL TAMAÑO DEL IMPERIO","size":8.0,"color":[95,168,232,255],"bold":true,"letter_spacing":2.0}}},{"id":12,"name":"Text","x":14.0,"y":307.0,"w":125.0,"h":18.0,"visible":true,"kind":{"Text":{"text":"«…levantaron un Mapa del Imperio, que tenía\nel tamaño del Imperio y coincidía\npuntualmente con él.»","size":11.0,"color":[255,255,255,255],"bold":false,"italic":true}}},{"id":13,"name":"Text","x":14.0,"y":326.0,"w":125.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Jorge Luis Borges, «Del rigor en la ciencia», 1946","size":7.0,"color":[143,179,217,255],"bold":false}}},{"id":14,"name":"Text","x":14.0,"y":343.0,"w":120.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"LOS 45 LUGARES, POR GRUPO","size":8.0,"color":[95,168,232,255],"bold":true,"letter_spacing":2.0}}},{"id":15,"name":"Circle","x":15.0,"y":349.0,"w":4.0,"h":4.0,"visible":true,"kind":{"Ellipse":{"fill":[228,87,46,255],"outline":[20,32,43,255],"width":0.4}}},{"id":16,"name":"Text","x":22.0,"y":348.6,"w":80.0,"h":4.5,"visible":true,"kind":{"Text":{"text":"Comer y beber · 14","size":8.5,"color":[230,236,245,255],"bold":false}}},{"id":17,"name":"Circle","x":15.0,"y":355.5,"w":4.0,"h":4.0,"visible":true,"kind":{"Ellipse":{"fill":[255,210,63,255],"outline":[20,32,43,255],"width":0.4}}},{"id":18,"name":"Text","x":22.0,"y":355.1,"w":80.0,"h":4.5,"visible":true,"kind":{"Text":{"text":"Comprar · 13","size":8.5,"color":[230,236,245,255],"bold":false}}},{"id":19,"name":"Circle","x":15.0,"y":362.0,"w":4.0,"h":4.0,"visible":true,"kind":{"Ellipse":{"fill":[123,211,137,255],"outline":[20,32,43,255],"width":0.4}}},{"id":20,"name":"Text","x":22.0,"y":361.6,"w":80.0,"h":4.5,"visible":true,"kind":{"Text":{"text":"Instituciones · 8","size":8.5,"color":[230,236,245,255],"bold":false}}},{"id":21,"name":"Circle","x":15.0,"y":368.5,"w":4.0,"h":4.0,"visible"