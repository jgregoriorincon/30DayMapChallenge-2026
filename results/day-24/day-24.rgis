55],"bold":true}}},{"id":38,"name":"Text","x":75.0,"y":248.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"a pie, unas 3 horas sin carga. La mitad de\nla bajada llega en el km 8,3; los últimos\n3,5 km, ya en el valle, son casi planos.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":39,"name":"Text","x":138.0,"y":239.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"21 %","size":20.0,"color":[194,24,91,255],"bold":true}}},{"id":40,"name":"Text","x":138.0,"y":248.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"de pendiente en el kilómetro más empinado:\n217 m de bajada en 1 km, con cinco tramos\nde escaleras. La pendiente media es 7 %.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":41,"name":"Line","x":12.0,"y":261.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[205,191,174,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":42,"name":"Text","x":12.0,"y":262.5,"w":186.0,"h":11.5,"visible":true,"kind":{"Text":{"text":"Desde 1918 hay registro de campesinos de Santa Elena que bajaban a Medellín con la silleta a la espalda para vender flores y\nhortalizas. En 1925, Braulio Ochoa, de la vereda El Llano, fue el primero en bajarla cargada de flores; se descargaban en la Placita\nde Flórez y se vendían en la calle. El 1 de mayo de 1957 desfilaron por primera vez. Hoy desfilan cada agosto en la Feria de las Flores.","size":7.0,"color":[78,70,60,255],"bold":false,"italic":true}}},{"id":43,"name":"Line","x":12.0,"y":275.5,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[205,191,174,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":44,"name":"Text","x":12.0,"y":276.5,"w":186.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Notas: el camino es el que hoy calcula Valhalla para ir a pie por la red de calles de OpenStreetMap, no el sendero histórico, que no está trazado. Alturas del modelo\ndigital de elevación de Medellín 2024 (1 m, terreno sin edificios), 300 muestras a lo largo del camino; relieve 3D exagerado 1,5 veces y perfil 2,5 veces. Datos: Alcaldía\nde Medellín (MDE 2024; «Historia de los silleteros», 2023); ruteo Valhalla; © colaboradores de OpenStreetMap.","size":5.6,"color":[133,122,108,255],"bold":false}}},{"id":45,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Día 24: Network · Hecho con RustGIS · rustgis.app","size":6.5,"color":[78,70,60,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":46},{"name":"Day 24","width":210.0,"height":297.0,"elements":[{"id":2,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[241,234,223,255],"outline":[241,234,223,0],"width":0.0}}},{"id":1,"name":"Map Frame","x":0.0,"y":38.0,"w":210.0,"h":146.0,"visible":true,"kind":{"MapFrame":{"map":"Medellín","center":{"x":-75.5292,"y":6.244},"scale":62500.0,"shape":"Rectangle","grid":null,"extent_of":null,"border_width":0.0,"pitch":35.0}}},{"id":3,"name":"Map Frame","x":12.0,"y":192.0,"w":186.0,"h":42.0,"visible":true,"kind":{"MapFrame":{"map":"Perfil","center":{"x":0.0611214,"y":0.0135825},"scale":84000.0,"shape":"Rectangle","grid":null,"extent_of":null,"border_width":0.0}}},{"id":4,"name":"Text","x":156.3,"y":137.7,"w":34.0,"h":4.0,"visible":true,"background":{"fill":[241,234,223,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.6},"kind":{"Text":{"text":"Santa Elena · 2,535 m","size":8.0,"color":[43,38,32,255],"bold":true,"align":"Right"}}},{"id":5,"name":"Text","x":42.3,"y":76.9,"w":40.0,"h":4.0,"visible":true,"background":{"fill":[241,234,223,204],"outline":[34,34,34,255],"radius":1.0,"padding":0.6},"kind":{"Text":{"text":"Placita de Flórez · 1,502 m","size":8.0,"color":[43,38,32,255],"bold":true}}},{"id":6,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 24 · NETWORK · MEDELLÍN","size":7.5,"color":[194,24,91,255],"bold":false,"letter_spacing":2.5}}},{"id":7,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Before it was a parade, it was a path","size":26.0,"color":[43,38,32,255],"bold":true}}},{"id":8,"name":"Text","x":12.0,"y":22.0,"w":186.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"The silleteros carried flowers on their backs from Santa Elena down to the Placita de Flórez market.\nThis is that walk today, along the street network: 1,000 metres lower.","size":9.0,"color":[78,70,60,255],"bold":false}}},{"id":9,"name":"Line","x":12.0,"y":33.8,"w":7.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[194,24,91,255],"width":2.2,"dir":"Horizontal","head":"None"}}},{"id":10,"name":"Text","x":21.0,"y":32.0,"w":62.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Walking path, on today's street network","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":11,"name":"Line","x":84.0,"y":33.8,"w":7.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[122,14,58,255],"width":3.6,"dir":"Horizontal","head":"None"}}},{"id":12,"name":"Text","x":93.0,"y":32.0,"w":40.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"The steepest kilometre","size":6.5,"color":[43,38,32,255],"bold":false}}},{"id":13,"name":"Text","x":128.0,"y":32.0,"w":18.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"Elevation (m)","size":6.5,"color":[43,38,32,255],"bold":false,"align":"Right"}}},{"id":14,"name":"Rectangle","x":148.0,"y":32.4,"w":7.5,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[115,172,98,255],"outline":[115,172,98,0],"width":0.0}}},{"id":15,"name":"Rectangle","x":155.5,"y":32.4,"w":7.5,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[181,202,121,255],"outline":[181,202,121,0],"width":0.0}}},{"id":16,"name":"Rectangle","x":163.0,"y":32.4,"w":7.5,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[224,205,132,255],"outline":[224,205,132,0],"width":0.0}}},{"id":17,"name":"Rectangle","x":170.5,"y":32.4,"w":7.5,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[184,142,93,255],"outline":[184,142,93,0],"width":0.0}}},{"id":18,"name":"Rectangle","x":178.0,"y":32.4,"w":7.5,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[154,119,89,255],"outline":[154,119,89,0],"width":0.0}}},{"id":19,"name":"Rectangle","x":185.5,"y":32.4,"w":7.5,"h":2.6,"visible":true,"kind":{"Rectangle":{"fill":[169,149,135,255],"outline":[169,149,135,0],"width":0.0}}},{"id":20,"name":"Text","x":143.0,"y":35.2,"w":10.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"1,500","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Center"}}},{"id":21,"name":"Text","x":165.5,"y":35.2,"w":10.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"2,100","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Center"}}},{"id":22,"name":"Text","x":188.0,"y":35.2,"w":10.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"2,700","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Center"}}},{"id":23,"name":"Text","x":12.0,"y":187.0,"w":120.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"PROFILE OF THE PATH · HEIGHT EXAGGERATED 2.5 TIMES","size":6.0,"color":[194,24,91,255],"bold":true,"letter_spacing":1.0}}},{"id":24,"name":"Text","x":12.0,"y":223.45,"w":10.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"1,600","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Right"}}},{"id":25,"name":"Text","x":12.0,"y":211.54,"w":10.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"2,000","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Right"}}},{"id":26,"name":"Text","x":12.0,"y":199.64,"w":10.5,"h":3.0,"visible":true,"kind":{"Text":{"text":"2,400","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Right"}}},{"id":27,"name":"Text","x":17.0,"y":231.6,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"0","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Center"}}},{"id":28,"name":"Text","x":76.52,"y":231.6,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"5","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Center"}}},{"id":29,"name":"Text","x":136.05,"y":231.6,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"10","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Center"}}},{"id":30,"name":"Text","x":184.0,"y":231.6,"w":14.0,"h":3.0,"visible":true,"kind":{"Text":{"text":"14.6 km","size":5.5,"color":[133,122,108,255],"bold":false,"align":"Right"}}},{"id":31,"name":"Text","x":25.5,"y":192.24,"w":60.0,"h":3.8,"visible":true,"kind":{"Text":{"text":"Santa Elena · 2,535 m","size":7.0,"color":[43,38,32,255],"bold":true}}},{"id":32,"name":"Text","x":136.0,"y":221.48,"w":60.0,"h":3.8,"visible":true,"kind":{"Text":{"text":"Placita de Flórez · 1,502 m","size":7.0,"color":[43,38,32,255],"bold":true,"align":"Right"}}},{"id":33,"name":"Text","x":126.0,"y":199.0,"w":70.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"THE STEEPEST KILOMETRE","size":6.0,"color":[122,14,58,255],"bold":true,"letter_spacing":1.0}}},{"id":34,"name":"Text","x":126.0,"y":202.7,"w":70.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"From 9.5 to 10.6: −217 m down the streets\nand stairs of La Sierra (comuna 8)","size":6.5,"color":[78,70,60,255],"bold":false}}},{"id":35,"name":"Text","x":12.0,"y":239.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"1,033 m","size":20.0,"color":[194,24,91,255],"bold":true}}},{"id":36,"name":"Text","x":12.0,"y":248.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"of drop: from 2,535 m in Santa Elena to\n1,502 m at the Placita de Flórez. Along the\nway it goes down 1,081 m and up just 48.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":37,"name":"Text","x":75.0,"y":239.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"14.6 km","size":20.0,"color":[194,24,91,255],"bold":true}}},{"id":38,"name":"Text","x":75.0,"y":248.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"on foot, about 3 hours without a load. Half\nthe drop is done by km 8.3; the last 3.5 km,\nalready in the valley, are almost flat.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":39,"name":"Text","x":138.0,"y":239.0,"w":60.0,"h":9.0,"visible":true,"kind":{"Text":{"text":"21%","size":20.0,"color":[194,24,91,255],"bold":true}}},{"id":40,"name":"Text","x":138.0,"y":248.5,"w":60.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"grade on the steepest kilometre: 217 m\ndown in 1 km, with five flights of stairs.\nThe average grade is 7%.","size":7.0,"color":[43,38,32,255],"bold":false}}},{"id":41,"name":"Line","x":12.0,"y":261.0,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[205,191,174,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":42,"name":"Text","x":12.0,"y":262.5,"w":186.0,"h":11.5,"visible":true,"kind":{"Text":{"text":"Since 1918 there are records of Santa Elena farmers walking down to Medellín with a silleta, a wooden chair-frame, on their backs\nto sell flowers and vegetables. In 1925 Braulio Ochoa, from the El Llano hamlet, was the first to carry it loaded with flowers; they were\nunloaded at the Placita de Flórez and sold in the streets. They first paraded on 1 May 1957. Today they parade every August at the Flower Fair.","size":7.0,"color":[78,70,60,255],"bold":false,"italic":true}}},{"id":43,"name":"Line","x":12.0,"y":275.5,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[205,191,174,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":44,"name":"Text","x":12.0,"y":276.5,"w":186.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"Notes: the path is the one Valhalla computes today for walking on the OpenStreetMap street network, not the historic trail, which is not mapped. Elevations from\nMedellín's 2024 digital elevation model (1 m, bare ground), 300 samples along the path; 3D relief exaggerated 1.5 times and profile 2.5 times. Data: Alcaldía de\nMedellín (DEM 2024; \"Historia de los silleteros\", 2023); Valhalla routing; © OpenStreetMap contributors.","size":5.6,"color":[133,122,108,255],"bold":false}}},{"id":45,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"© José Gregorio Rincón · CC BY 4.0 · #30DayMapChallenge 2026 · Day 24: Network · Made with RustGIS · rustgis.app","size":6.5,"color":[78,70,60,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":46}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}