88.0,"visible":true,"kind":{"MapFrame":{"map":"Barranquilla","center":{"x":-74.8205,"y":10.984},"scale":85000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DÍA 15 · DEL REVÉS · BARRANQUILLA","size":7.5,"color":[0,56,184,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"Cuando llueve, la calle es el río","size":26.0,"color":[20,32,43,255],"bold":true}}},{"id":5,"name":"Text","x":12.0,"y":22.5,"w":186.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Los arroyos de Barranquilla según por dónde va el agua: por dentro, bajo tierra, o por fuera, por la calle","size":9.0,"color":[74,88,102,255],"bold":false}}},{"id":6,"name":"Text","x":10.0,"y":219.0,"w":60.0,"h":15.0,"visible":true,"kind":{"Text":{"text":"65 km","size":36.0,"color":[0,56,184,255],"bold":true}}},{"id":7,"name":"Text","x":10.0,"y":235.0,"w":60.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"de calles están hechas para ser\nrío: cuando llueve, el arroyo baja\npor ellas. Se llaman viacanales.","size":7.5,"color":[43,56,70,255],"bold":false}}},{"id":8,"name":"Text","x":10.0,"y":250.0,"w":60.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Otros 80 km de arroyos siguen sin canalizar,\ny solo 23 km van bajo tierra.","size":6.5,"color":[74,88,102,255],"bold":false}}},{"id":9,"name":"Text","x":74.0,"y":221.0,"w":60.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"CÓMO VA EL AGUA","size":6.5,"color":[0,56,184,255],"bold":true,"letter_spacing":1.2}}},{"id":10,"name":"Line","x":74.0,"y":228.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[0,56,184,255],"width":2.6,"dir":"Horizontal","head":"None"}}},{"id":11,"name":"Text","x":86.0,"y":226.5,"w":50.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Por la calle (viacanal) · 64,7 km","size":6.5,"color":[20,32,43,255],"bold":true}}},{"id":12,"name":"Line","x":74.0,"y":234.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[30,136,229,255],"width":1.6,"dir":"Horizontal","head":"None"}}},{"id":13,"name":"Text","x":86.0,"y":232.5,"w":50.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Sin canalizar · 80,4 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":14,"name":"Line","x":74.0,"y":240.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[0,137,123,255],"width":1.3,"dir":"Horizontal","head":"None"}}},{"id":15,"name":"Text","x":86.0,"y":238.5,"w":50.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Canalizado a cielo abierto · 83,2 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":16,"name":"Line","x":74.0,"y":246.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[55,71,79,255],"width":1.1,"dir":"Horizontal","head":"None","dash":[3.0,2.0]}}},{"id":17,"name":"Text","x":86.0,"y":244.5,"w":50.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Bajo tierra · 23,3 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":18,"name":"Line","x":74.0,"y":252.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[154,163,173,255],"width":0.7,"dir":"Horizontal","head":"None"}}},{"id":19,"name":"Text","x":86.0,"y":250.5,"w":50.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Sin información o en obra · 39,2 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":20,"name":"Text","x":74.0,"y":257.0,"w":62.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"«Sin canalizar» no siempre es calle: los\nmás largos, los arroyos León y Grande, son\ncauces naturales del occidente.","size":6.0,"color":[111,122,135,255],"bold":false}}},{"id":21,"name":"Text","x":140.0,"y":221.0,"w":60.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"DOS CIUDADES","size":6.5,"color":[0,56,184,255],"bold":true,"letter_spacing":1.2}}},{"id":22,"name":"Text","x":140.0,"y":226.5,"w":60.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Hacia el Magdalena, la ciudad vieja · 89 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":23,"name":"Rectangle","x":140.0,"y":231.0,"w":8.99,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,56,184,255],"outline":[245,242,237,255],"width":0.2}}},{"id":24,"name":"Rectangle","x":148.99,"y":231.0,"w":7.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,137,123,255],"outline":[245,242,237,255],"width":0.2}}},{"id":25,"name":"Rectangle","x":156.19,"y":231.0,"w":7.42,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[55,71,79,255],"outline":[245,242,237,255],"width":0.2}}},{"id":26,"name":"Rectangle","x":163.61,"y":231.0,"w":7.58,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[154,163,173,255],"outline":[245,242,237,255],"width":0.2}}},{"id":27,"name":"Text","x":140.0,"y":237.5,"w":62.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Hacia Mallorquín, la ciudad que crece · 153 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":28,"name":"Rectangle","x":140.0,"y":242.0,"w":1.43,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,56,184,255],"outline":[245,242,237,255],"width":0.2}}},{"id":29,"name":"Rectangle","x":141.43,"y":242.0,"w":26.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[30,136,229,255],"outline":[245,242,237,255],"width":0.2}}},{"id":30,"name":"Rectangle","x":167.63,"y":242.0,"w":19.83,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,137,123,255],"outline":[245,242,237,255],"width":0.2}}},{"id":31,"name":"Rectangle","x":187.46,"y":242.0,"w":6.14,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[154,163,173,255],"outline":[245,242,237,255],"width":0.2}}},{"id":32,"name":"Text","x":140.0,"y":248.0,"w":62.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"La ciudad vieja ya le dio cauce a sus arroyos:\npor la calle o bajo tierra. En la que crece,\ncasi la mitad (49 %) sigue sin canalizar.","size":6.5,"color":[74,88,102,255],"bold":false}}},{"id":33,"name":"Text","x":140.0,"y":259.0,"w":62.0,"h":6.5,"visible":true,"kind":{"Text":{"text":"Otros 48 km no traen cuenca en el dato (35 de\nellos, viacanal).","size":6.0,"color":[111,122,135,255],"bold":false}}},{"id":34,"name":"North Arrow","x":140.0,"y":268.5,"w":4.0,"h":6.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[74,88,102,255],"outline":[74,88,102,255]}}},{"id":35,"name":"Scale Bar","x":148.0,"y":269.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[74,88,102,255],"fill":[255,255,255,255]}}},{"id":36,"name":"Line","x":12.0,"y":278.5,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[201,195,184,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":37,"name":"Text","x":12.0,"y":280.0,"w":186.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Datos: Alcaldía de Barranquilla, Mi Ciudad: arroyos (Secretaría de Planeación y Agencia Distrital de Infraestructura), CC BY-SA 4.0, consultado el 2026-11-13.\nMapa base: Mi Ciudad, Alcaldía de Barranquilla. Kilómetros medidos sobre la misma capa, en UTM 18N. Este mapa y su proyecto: CC BY-SA 4.0.\nCómo se hizo: todo en RustGIS web (web.rustgis.app): una capa por URL, cinco grupos por expresión y trazos por niveles (lo que va bajo tierra, punteado).\nScripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.5,"color":[111,122,135,255],"bold":false}}},{"id":38,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Día 15: Inside out · Hecho con RustGIS · rustgis.app","size":6.5,"color":[0,56,184,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":39},{"name":"Day 15","width":210.0,"height":297.0,"elements":[{"id":2,"name":"Rectangle","x":0.0,"y":0.0,"w":210.0,"h":297.0,"visible":true,"kind":{"Rectangle":{"fill":[245,242,237,255],"outline":[245,242,237,255],"width":0.0}}},{"id":1,"name":"Map Frame","x":0.0,"y":29.0,"w":210.0,"h":188.0,"visible":true,"kind":{"MapFrame":{"map":"Barranquilla","center":{"x":-74.8205,"y":10.984},"scale":85000.0,"shape":"Rectangle","grid":null,"extent_of":null}}},{"id":3,"name":"Text","x":12.0,"y":5.5,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"30DAYMAPCHALLENGE · DAY 15 · INSIDE OUT · BARRANQUILLA","size":7.5,"color":[0,56,184,255],"bold":false,"letter_spacing":2.5}}},{"id":4,"name":"Text","x":12.0,"y":10.0,"w":186.0,"h":12.0,"visible":true,"kind":{"Text":{"text":"When it rains, the street is the river","size":26.0,"color":[20,32,43,255],"bold":true}}},{"id":5,"name":"Text","x":12.0,"y":22.5,"w":186.0,"h":5.0,"visible":true,"kind":{"Text":{"text":"Barranquilla's storm streams by where the water runs: inside, underground, or outside, down the street","size":9.0,"color":[74,88,102,255],"bold":false}}},{"id":6,"name":"Text","x":10.0,"y":219.0,"w":60.0,"h":15.0,"visible":true,"kind":{"Text":{"text":"65 km","size":36.0,"color":[0,56,184,255],"bold":true}}},{"id":7,"name":"Text","x":10.0,"y":235.0,"w":62.0,"h":13.0,"visible":true,"kind":{"Text":{"text":"of streets are built to be a river:\nwhen it rains, the stream runs\ndown them. They are called viacanales.","size":7.5,"color":[43,56,70,255],"bold":false}}},{"id":8,"name":"Text","x":10.0,"y":250.0,"w":62.0,"h":7.0,"visible":true,"kind":{"Text":{"text":"Another 80 km of streams are still not\nchannelled, and only 23 km run underground.","size":6.5,"color":[74,88,102,255],"bold":false}}},{"id":9,"name":"Text","x":74.0,"y":221.0,"w":60.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"HOW THE WATER RUNS","size":6.5,"color":[0,56,184,255],"bold":true,"letter_spacing":1.2}}},{"id":10,"name":"Line","x":74.0,"y":228.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[0,56,184,255],"width":2.6,"dir":"Horizontal","head":"None"}}},{"id":11,"name":"Text","x":86.0,"y":226.5,"w":52.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Down the street (viacanal) · 64.7 km","size":6.5,"color":[20,32,43,255],"bold":true}}},{"id":12,"name":"Line","x":74.0,"y":234.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[30,136,229,255],"width":1.6,"dir":"Horizontal","head":"None"}}},{"id":13,"name":"Text","x":86.0,"y":232.5,"w":52.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Not channelled · 80.4 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":14,"name":"Line","x":74.0,"y":240.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[0,137,123,255],"width":1.3,"dir":"Horizontal","head":"None"}}},{"id":15,"name":"Text","x":86.0,"y":238.5,"w":52.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Open channel · 83.2 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":16,"name":"Line","x":74.0,"y":246.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[55,71,79,255],"width":1.1,"dir":"Horizontal","head":"None","dash":[3.0,2.0]}}},{"id":17,"name":"Text","x":86.0,"y":244.5,"w":52.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Underground · 23.3 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":18,"name":"Line","x":74.0,"y":252.0,"w":9.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[154,163,173,255],"width":0.7,"dir":"Horizontal","head":"None"}}},{"id":19,"name":"Text","x":86.0,"y":250.5,"w":52.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"No data or under construction · 39.2 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":20,"name":"Text","x":74.0,"y":257.0,"w":62.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"\"Not channelled\" is not always a street: the\nlongest, the León and Grande streams, are\nnatural creeks on the western edge.","size":6.0,"color":[111,122,135,255],"bold":false}}},{"id":21,"name":"Text","x":140.0,"y":221.0,"w":60.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"TWO CITIES","size":6.5,"color":[0,56,184,255],"bold":true,"letter_spacing":1.2}}},{"id":22,"name":"Text","x":140.0,"y":226.5,"w":62.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Towards the Magdalena, the old city · 89 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":23,"name":"Rectangle","x":140.0,"y":231.0,"w":8.99,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,56,184,255],"outline":[245,242,237,255],"width":0.2}}},{"id":24,"name":"Rectangle","x":148.99,"y":231.0,"w":7.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,137,123,255],"outline":[245,242,237,255],"width":0.2}}},{"id":25,"name":"Rectangle","x":156.19,"y":231.0,"w":7.42,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[55,71,79,255],"outline":[245,242,237,255],"width":0.2}}},{"id":26,"name":"Rectangle","x":163.61,"y":231.0,"w":7.58,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[154,163,173,255],"outline":[245,242,237,255],"width":0.2}}},{"id":27,"name":"Text","x":140.0,"y":237.5,"w":62.0,"h":3.5,"visible":true,"kind":{"Text":{"text":"Towards Mallorquín, the growing city · 153 km","size":6.5,"color":[43,56,70,255],"bold":false}}},{"id":28,"name":"Rectangle","x":140.0,"y":242.0,"w":1.43,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,56,184,255],"outline":[245,242,237,255],"width":0.2}}},{"id":29,"name":"Rectangle","x":141.43,"y":242.0,"w":26.2,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[30,136,229,255],"outline":[245,242,237,255],"width":0.2}}},{"id":30,"name":"Rectangle","x":167.63,"y":242.0,"w":19.83,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[0,137,123,255],"outline":[245,242,237,255],"width":0.2}}},{"id":31,"name":"Rectangle","x":187.46,"y":242.0,"w":6.14,"h":3.0,"visible":true,"kind":{"Rectangle":{"fill":[154,163,173,255],"outline":[245,242,237,255],"width":0.2}}},{"id":32,"name":"Text","x":140.0,"y":248.0,"w":62.0,"h":10.0,"visible":true,"kind":{"Text":{"text":"The old city has given its streams a course:\ndown the street or underground. In the growing\none, almost half (49%) is still not channelled.","size":6.5,"color":[74,88,102,255],"bold":false}}},{"id":33,"name":"Text","x":140.0,"y":259.0,"w":62.0,"h":6.5,"visible":true,"kind":{"Text":{"text":"Another 48 km have no basin in the data (35 of\nthem, viacanal).","size":6.0,"color":[111,122,135,255],"bold":false}}},{"id":34,"name":"North Arrow","x":140.0,"y":268.5,"w":4.0,"h":6.0,"visible":true,"kind":{"NorthArrow":{"frame":1,"style":"Triangle","fill":[74,88,102,255],"outline":[74,88,102,255]}}},{"id":35,"name":"Scale Bar","x":148.0,"y":269.0,"w":40.0,"h":6.0,"visible":true,"kind":{"ScaleBar":{"frame":1,"units":"Kilometers","divisions":2,"style":"Line","color":[74,88,102,255],"fill":[255,255,255,255]}}},{"id":36,"name":"Line","x":12.0,"y":278.5,"w":186.0,"h":0.5,"visible":true,"kind":{"Line":{"color":[201,195,184,255],"width":0.5,"dir":"Horizontal","head":"None"}}},{"id":37,"name":"Text","x":12.0,"y":280.0,"w":186.0,"h":11.0,"visible":true,"kind":{"Text":{"text":"Data: Barranquilla City Hall, Mi Ciudad: storm streams (Planning Department and District Infrastructure Agency), CC BY-SA 4.0, accessed 2026-11-13.\nBasemap: Mi Ciudad, Barranquilla City Hall. Kilometres measured on the same layer, in UTM 18N. This map and its project: CC BY-SA 4.0.\nHow it was made: all in RustGIS web (web.rustgis.app): one layer by URL, five groups by expression and strokes by levels (underground, dashed).\nScripts: github.com/jgregoriorincon/30DayMapChallenge-2026","size":5.5,"color":[111,122,135,255],"bold":false}}},{"id":38,"name":"Text","x":12.0,"y":292.3,"w":186.0,"h":4.0,"visible":true,"kind":{"Text":{"text":"#30DayMapChallenge 2026 · Day 15: Inside out · Made with RustGIS · rustgis.app","size":6.5,"color":[0,56,184,255],"bold":false,"align":"Right"}}}],"series":null,"next_id":39}],"folders":[],"styles":[],"ramps":[],"tasks":[],"gp_env":{"extent":null,"cell_size":null},"models":[],"workspaces":[],"link_views":false,"jobs":[],"offline_areas":[],"reports":[],"presentations":[],"notebooks":[],"dl_models":[],"shared":[],"data_stores":[]}